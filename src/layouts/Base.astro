---
import '@fontsource-variable/manrope';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '../styles/atlas.css';
import Icon from '../components/Icon.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import {github, path, siteUrl} from '../lib/format';
import {guideDestinations} from '../lib/navigation';

interface Props {title: string; description: string; section?: string; noindex?: boolean}
const {title, description, section, noindex = false} = Astro.props;
const fullTitle = section === 'Explore' ? 'Mutta Puffs Everywhere · The egg puff atlas' : title + ' · Mutta Puffs Everywhere';
const canonical = new URL(Astro.url.pathname, siteUrl.origin);
const activeSection = section ?? (guideDestinations.some(({route}) => canonical.pathname.startsWith(path(route))) ? 'Puff Guide' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Mutta Puffs Everywhere" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(path('images/egg-puff.webp'), siteUrl.origin)} />
    <meta name="theme-color" content="#f9f2e4" />
    <link rel="manifest" href={path('manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={path('icons/puff-192.png')} />
    <link rel="icon" type="image/svg+xml" href={path('puff.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="shell header-inner">
        <a href={path()} class="wordmark"><span class="brand-icon"><Icon name="puff" size={24} /></span><span>Mutta Puffs<small>Everywhere</small></span></a>
        <SiteNavigation variant="desktop" pathname={canonical.pathname} activeSection={activeSection} />
        <details class="mobile-menu">
          <summary class="button secondary small"><Icon name="menu" size={19} /> Menu</summary>
          <SiteNavigation variant="mobile" pathname={canonical.pathname} activeSection={activeSection} />
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div><a class="footer-brand" href={path()}>Mutta Puffs Everywhere</a><p>A community atlas for one very good snack.</p></div>
        <nav aria-label="Project">
          <a href={path('about/')}>About</a>
          <a href={path('about/#data')}>Open data</a>
          <a href={github}>GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
<script>
  import {startAnalytics} from '../scripts/analytics';
  import {enableApp} from '../scripts/pwa';

  const masthead = document.querySelector<HTMLElement>('.masthead')!;
  function updateScrollPadding() {
    const height = Math.ceil(masthead.getBoundingClientRect().height);
    document.documentElement.style.setProperty('--masthead-height', height + 'px');
  }
  updateScrollPadding();
  if ('ResizeObserver' in window) new ResizeObserver(updateScrollPadding).observe(masthead);

  const mobileMenu = masthead.querySelector<HTMLDetailsElement>('.mobile-menu')!;
  const menuSummary = mobileMenu.querySelector<HTMLElement>('summary')!;
  mobileMenu.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenu.open) {
      mobileMenu.open = false;
      menuSummary.focus();
    }
  });
  masthead.addEventListener('focusout', (event) => {
    if (event.relatedTarget instanceof Node && !masthead.contains(event.relatedTarget)) {
      mobileMenu.open = false;
    }
  });
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !mobileMenu.contains(event.target)) {
      mobileMenu.open = false;
    }
  });

  enableApp();
  startAnalytics();
</script>
