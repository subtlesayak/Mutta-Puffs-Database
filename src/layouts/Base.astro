---
import '@fontsource-variable/manrope';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '../styles/atlas.css';
import Icon from '../components/Icon.astro';
import {atlas} from '../lib/catalogue';
import SiteNavigation from '../components/SiteNavigation.astro';
import {github, localizedPath, path, siteUrl} from '../lib/format';
import {guideDestinations} from '../lib/navigation';
import {labelSets, locales, type Locale} from '../lib/locales';

interface Props {title: string; description: string; section?: string; noindex?: boolean; locale?: Locale; languageRoute?: string}
const {title, description, section, noindex = false, locale = 'en', languageRoute = section === 'Explore' ? '' : undefined} = Astro.props;
const labels = labelSets[locale];
const home = localizedPath('',locale);
const equivalents = languageRoute === undefined ? [] :
  locales.map(language => ({...language,href:localizedPath(languageRoute,language.id)}));
const languageHref = equivalents.length ? '#page-languages' : path('languages/');
const fullTitle = section === 'Explore' && locale === 'en' ? 'Mutta Puffs Everywhere · The egg puff atlas' : title + ' · Mutta Puffs Everywhere';
const canonical = new URL(Astro.url.pathname, siteUrl.origin);
const activeSection = section ?? (guideDestinations.some(({route}) => canonical.pathname.startsWith(path(route))) ? 'Puff Guide' : undefined);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {equivalents.map(language => <link rel="alternate" hreflang={language.id} href={new URL(language.href,siteUrl.origin)} />)}
    <meta property="og:site_name" content="Mutta Puffs Everywhere" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(path('images/egg-puff.webp'), siteUrl.origin)} />
    <meta name="theme-color" content="#f9f2e4" />
    <link rel="manifest" href={path('manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={path('icons/puff-192.png')} />
    <link rel="icon" type="image/svg+xml" href={path('puff.svg')} />
  </head>
  <body data-place-aliases={JSON.stringify(atlas.place_aliases)}>
    <a class="skip" href="#main">{labels.skip}</a>
    <header class="masthead">
      <div class="shell header-inner">
        <a href={home} class="wordmark"><span class="brand-icon"><Icon name="puff" size={24} /></span><span>Mutta Puffs<small>Everywhere</small></span></a>
        <SiteNavigation variant="desktop" pathname={canonical.pathname} activeSection={activeSection} locale={locale} languageHref={languageHref} />
        <details class="mobile-menu">
          <summary class="button secondary small"><Icon name="menu" size={19} /> {labels.menu}</summary>
          <SiteNavigation variant="mobile" pathname={canonical.pathname} activeSection={activeSection} locale={locale} languageHref={languageHref} />
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div><a class="footer-brand" href={home}>Mutta Puffs Everywhere</a><p>{labels.footerIntro}</p></div>
        <nav aria-label={labels.projectNav}>
          <a href={path('about/')}>{labels.about}</a>
          <a href={path('about/#data')}>{labels.data}</a>
          <a href={github}>GitHub</a>
        </nav>
      </div>
      {equivalents.length > 0 && <nav class="shell page-languages" id="page-languages" aria-label={labels.language} tabindex="-1">
        {equivalents.map(language => <a href={language.href} hreflang={language.id} lang={language.id} aria-current={language.id === locale ? 'page' : undefined}>{language.name}</a>)}
      </nav>}
    </footer>
  </body>
</html>
<style>
  .page-languages {display:flex;flex-wrap:wrap;gap:.15rem 1rem;padding-block:0 1.25rem;}
  .page-languages a[aria-current="page"] {font-weight:800;text-decoration-thickness:.14em;}
</style>
<script>
  import {applyMapPreference} from '../lib/map-preference';
  import {rememberPageLanguage} from '../lib/language-preference';
  import {startAnalytics} from '../scripts/analytics';
  import {enableApp} from '../scripts/pwa';

  const masthead = document.querySelector<HTMLElement>('.masthead')!;
  function updateScrollPadding() {
    const height = Math.ceil(masthead.getBoundingClientRect().height);
    document.documentElement.style.setProperty('--masthead-height', height + 'px');
  }
  updateScrollPadding();
  if ('ResizeObserver' in window) new ResizeObserver(updateScrollPadding).observe(masthead);

  const mobileMenu = masthead.querySelector<HTMLDetailsElement>('.mobile-menu')!;
  const menuSummary = mobileMenu.querySelector<HTMLElement>('summary')!;
  mobileMenu.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenu.open) {
      mobileMenu.open = false;
      menuSummary.focus();
    }
  });
  masthead.addEventListener('focusout', (event) => {
    if (event.relatedTarget instanceof Node && !masthead.contains(event.relatedTarget)) {
      mobileMenu.open = false;
    }
  });
  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !mobileMenu.contains(event.target)) {
      mobileMenu.open = false;
    }
  });

  applyMapPreference();
  rememberPageLanguage();
  enableApp();
  startAnalytics();
</script>
