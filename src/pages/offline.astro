---
import Base from '../layouts/Base.astro';
import {path} from '../lib/format';
---
<Base title="You’re offline" description="Use the offline atlas or prepare a contribution for when you reconnect." noindex>
  <div class="shell">
    <header class="page-head"><h1>You’re offline.</h1><p>Browse the saved place list or draft a contribution. GitHub submissions need a connection.</p></header>
    <div class="actions"><a class="button" href={path('#nearby')}>Browse saved places</a><a class="button secondary" href={path('contribute/')}>Draft a contribution</a></div>
  </div>
</Base>
