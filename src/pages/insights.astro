---
import Base from '../layouts/Base.astro';
import {atlas} from '../lib/catalogue';
import {accuracyLabels, formatDate, formatNumber, path, placePath} from '../lib/format';
const stats = atlas.stats;
const verified = atlas.places.filter(place => place.verification.last_verified)
  .sort((a,b) => b.verification.last_verified!.localeCompare(a.verification.last_verified!)).slice(0,5);
const needsDetails = atlas.places.filter(place => place.verification.status === 'needs_details');
const tables = [
  {title:'Countries',counts: Object.entries(stats.countries)},
  {title:'Indian states and territories',counts:Object.entries(stats.states)},
  {title:'Districts',counts:Object.entries(stats.districts)},
  {title:'Coordinate accuracy',counts:Object.entries(stats.accuracy).map(([key,count]) => [accuracyLabels[key as keyof typeof accuracyLabels],count] as const)},
];
---
<Base title="Insights" section="Insights" description="Explore the atlas coverage, coordinate accuracy, community notes, and downloadable charts and reports.">
  <div class="shell">
    <header class="page-head"><p class="kicker">Atlas insights</p><h1>From crumbs to counts.</h1><p>See where the directory is strongest and where first-hand reports would help.</p></header>
    <dl class="insight-stats">
      {[[stats.places,'Saved places'],[stats.mappable,'Mappable'],[stats.notes,'Archive notes'],[stats.reviews,'Approved reviews']].map(([count,label]) => <div class="panel"><dt>{label}</dt><dd>{count}</dd></div>)}
    </dl>
    <div class="actions insights-links">
      <a class="button secondary" href={path('price-index/')}>Mutta Puff Index</a>
      <a class="button secondary" href={path('leaderboard/')}>Puff Leaderboard</a>
      <a class="text-link" href="#verify">Help check a listing</a>
    </div>
    <section class="section grid-2" aria-label="Coverage counts">
      {tables.map(({title,counts}) => {
        const peak = Math.max(1,...counts.map(([,n])=>n));
        const rows = (values: typeof counts) => values.map(([label,n]) => <li><div><span>{label}</span><strong>{formatNumber(n)}</strong></div><div class="track" aria-hidden="true"><div style={'width:' + (n / peak * 100) + '%'}></div></div></li>);
        return <div class="panel"><h2 class="smaller">{title}</h2><ol class="bars">{rows(counts.slice(0,8))}</ol>
          {counts.length > 8 && <details><summary>Show all {title.toLowerCase()}</summary><ol class="bars">{rows(counts.slice(8))}</ol></details>}</div>;
      })}
    </section>
    <section class="section grid-2" id="verify" aria-label="Community verification">
      <div class="panel">
        <h2 class="smaller">Recently verified</h2>
        {verified.length ? <ul>{verified.map(place => <li><a href={placePath(place.id)}>{place.name}</a> · {formatDate(place.verification.last_verified!)}</li>)}</ul>
          : <p class="muted">The atlas is waiting for its first independent verification.</p>}
        <a class="text-link" href={path('map/?accuracy=estimated')}>Find estimated pins on the map</a>
      </div>
      <div class="panel">
        <h2 class="smaller">Listings that need details</h2>
        <p class="muted">Identify an unnamed stall at a landmark or add a public map link when you can confirm the place.</p>
        {needsDetails.length ? <ul>{needsDetails.map(place => <li><a href={placePath(place.id)}>{place.name}</a></li>)}</ul> : <p>All listings currently have basic place details.</p>}
      </div>
    </section>
    <section class="section grid-2">
      <div>
        <h2>Detailed analysis</h2>
        <p class="analysis-copy">The detailed offline report includes the latest coverage tables, contributor notes, a southern India overview, and the search and map tools.</p>
        <a class="button" href={path('analysis/index.html')}>Open the detailed report</a>
        <div class="actions">
          <a class="text-link" href={path('analysis/places.csv')}>Download analysis CSV</a>
          <a class="text-link" href={path('api/v1/stats.json')}>Atlas statistics JSON</a>
        </div>
        <p class="muted">District labels contain data from <a href="https://www.geoboundaries.org/api/current/gbOpen/IND/ADM2/">geoBoundaries India ADM2</a> under the <a href="https://opendatacommons.org/licenses/odbl/1-0/">Open Database License</a>.</p>
      </div>
      <div><img class="infographic" src={path('visuals/mutta-puff-trail.png')} width="1200" height="1530" loading="lazy" alt={`Crowdsourced map and state counts for ${formatNumber(stats.archive.rows)} saved entries, with three contributor tips.`} /></div>
    </section>
  </div>
</Base>
<style>
  .insight-stats {display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,11rem),1fr)); gap:.8rem;}
  .insight-stats dd {margin:0; color:var(--rust); font:650 2.65rem/1.12 var(--display);}
  .insight-stats dt {font-weight:800;}
  .smaller {font-size:1.65rem;}
  .bars {list-style:none; margin:.7rem 0 0; padding:0;}
  .bars li {padding:.4rem 0;}
  .bars li>div:first-child {display:flex; justify-content:space-between; gap:.75rem;}
  .bars strong {font-variant-numeric:tabular-nums;}
  .track {background:var(--butter); block-size:.35rem; border-radius:99px; overflow:hidden;}
  .track>div {background:var(--rust); block-size:100%; border-radius:99px;}
  summary {font-weight:750; margin-block-start:.7rem; cursor:pointer;}
  .analysis-copy {margin:.8rem 0 1rem;}
  .infographic {border-radius:var(--round); border:1px solid var(--line);}
  .insights-links {margin-block-start:1rem;}
</style>
