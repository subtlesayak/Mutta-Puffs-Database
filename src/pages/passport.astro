---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {atlas} from '../lib/catalogue';
import {path} from '../lib/format';
const places = [...atlas.places].sort((a,b) => a.name.localeCompare(b.name));
---
<Base title="Puff Passport" description="Save puff spots, log your visits, and collect a private stamp for every bakery you visit.">
  <div class="shell" data-passport>
    <header class="page-head"><p class="kicker">Your bakery diary</p><h1>Puff Passport</h1><p>Save a spot for later and collect a stamp when you visit. This diary stays in this browser.</p>
      <div class="actions"><a class="text-link" href={path('wrapped/')}>See your Puff Wrapped <Icon name="arrow" size={17} /></a></div>
    </header>
    <p class="live-note" data-passport-status role="status"></p>
    <noscript><p class="panel">Enable JavaScript to save places and log visits in this browser.</p></noscript>
    <div class="grid-2 passport-grid" data-passport-content hidden>
      <form class="panel" data-visit-form>
        <h2>Log a visit</h2>
        <label class="field">Puff spot <select name="place" required><option value="">Choose a place</option>
          {places.map(place => <option value={place.id} data-city={place.location.city} data-country={place.location.country}>{place.name}{place.location.city ? ' · ' + place.location.city : ''}</option>)}
        </select></label>
        <label class="field">Visit date <input name="date" type="date" required /></label>
        <div class="fields">
          <label class="field">Total paid <input name="amount" type="number" min="0" max="1000000" step="0.01" inputmode="decimal" placeholder="Optional" /></label>
          <label class="field">Currency <input name="currency" pattern={'[A-Za-z]{3}'} maxlength="3" autocapitalize="characters" placeholder="INR" /></label>
        </div>
        <label class="field">Private note <textarea name="note" maxlength="500" placeholder="What would you order again?"></textarea></label>
        <div class="actions"><button class="button" type="submit">Add visit</button><button class="button secondary" type="button" data-save-place>Save place for later</button></div>
      </form>
      <section class="panel stamps" aria-labelledby="stamps-title">
        <h2 id="stamps-title">Stamp book</h2><p data-stamp-count class="muted"></p>
        <ul class="stamp-grid" data-stamps></ul>
      </section>
      <section class="panel" aria-labelledby="saved-title">
        <h2 id="saved-title">Saved for later</h2><p data-saved-empty class="muted">Save a bakery to start a list for your next outing.</p>
        <ul class="plain-list" data-saved></ul>
      </section>
      <section class="panel" aria-labelledby="history-title">
        <h2 id="history-title">Visit history</h2><p data-history-empty class="muted">Your first visit starts the diary.</p>
        <button class="button secondary small" type="button" data-undo hidden>Undo removal</button>
        <ul class="plain-list" data-visits></ul>
      </section>
    </div>
  </div>
</Base>
<style>
  .passport-grid {align-items:start;}
  [data-visit-form] {display:grid;gap:.8rem;}
  .stamps {background:var(--butter);}
  .stamp-grid {list-style:none;margin-block-end:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,9rem),1fr));gap:.65rem;}
  .stamp-grid :global(li) {background:var(--surface);border:1px dashed var(--pine);border-radius:.8rem;padding:.7rem;overflow-wrap:anywhere;}
  .stamp-grid :global(a) {font:700 1.1rem/1.2 var(--display);}
  .plain-list :global(li) {padding-block:.58rem;border-block-end:1px solid var(--line);}
  .plain-list :global(button) {margin-block-start:.4rem;}
  .plain-list :global(p) {overflow-wrap:anywhere;}
</style>
<script>
  import {startPassport} from '../scripts/passport';
  startPassport();
</script>
