---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {path} from '../lib/format';
import {guideDestinations} from '../lib/navigation';
---
<Base title="Puff Guide" section="Puff Guide" description="Discover puff trails, a private bakery passport, a random nearby spot, and stories from the bakery counter.">
  <div class="shell">
    <header class="page-head">
      <h1>Puff Guide</h1>
      <p>Plan a bakery outing, remember where you’ve been, and find out what goes into a good puff.</p>
    </header>
    <ul class="tile-grid guide-grid">
      {guideDestinations.map(({title, route, description, label}) => (
        <li class:list={['panel', 'feature-tile', { 'guide-trails': route === 'trails/', 'guide-passport': route === 'passport/' }]}>
          {route === 'trails/' && (
            <img src={path('images/egg-puff.webp')} width="1536" height="1024" alt="" />
          )}
          <h2>{title}</h2>
          <p>{description}</p>
          <a class="text-link" href={path(route)}>{label} <Icon name="arrow" size={16} /></a>
        </li>
      ))}
    </ul>
  </div>
</Base>
<script>
  const grid = document.querySelector<HTMLElement>('.guide-grid');

  if (grid && 'ResizeObserver' in window) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.feature-tile'));

    const measureCards = () => {
      const gap = Number.parseFloat(getComputedStyle(grid).columnGap);
      // Reserve one grid row per pixel of card height, plus the space below it.
      const spans = cards.map(card => Math.ceil(card.getBoundingClientRect().height + gap));
      cards.forEach((card, index) => card.style.setProperty('--card-rows', String(spans[index])));
      grid.dataset.masonry = '';
    };

    measureCards();
    const observer = new ResizeObserver(measureCards);
    cards.forEach(card => observer.observe(card, { box: 'border-box' }));
  }
</script>
<style>
  .guide-grid {
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
  }
  .guide-grid .feature-tile { grid-template-rows: none; align-content: start; }
  .guide-trails { background: var(--butter); }
  .guide-passport { background: var(--sage); }
  .guide-trails img {
    inline-size: 100%;
    aspect-ratio: 2.25 / 1;
    object-fit: cover;
    border-radius: .6rem;
    margin-block-end: .25rem;
  }
  @media (min-width: 38rem) {
    .guide-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .guide-grid[data-masonry] { grid-auto-rows: 1px; row-gap: 0; }
    .guide-grid[data-masonry] .feature-tile { grid-row-end: span var(--card-rows); }
  }
  @media (min-width: 64rem) {
    .guide-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
