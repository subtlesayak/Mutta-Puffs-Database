---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {path} from '../lib/format';
import {guideDestinations} from '../lib/navigation';
---
<Base title="Puff Guide" section="Puff Guide" description="Discover puff trails, a private bakery passport, a random nearby spot, and stories from the bakery counter.">
  <div class="shell">
    <header class="page-head"><p class="kicker">Mutta Puffs Everywhere</p><h1>Puff Guide</h1><p>Plan a bakery outing, remember where you’ve been, and find out what goes into a good puff.</p></header>
    <ul class="tile-grid guide-grid">{guideDestinations.map(({title,route,description,label}) => <li class="panel feature-tile">
      <h2>{title}</h2><p>{description}</p><a class="text-link" href={path(route)}>{label} <Icon name="arrow" size={16} /></a>
    </li>)}</ul>
  </div>
</Base>
<style>
  .guide-grid .feature-tile {grid-template-rows:auto 1fr auto;}
  .guide-grid .feature-tile:first-child {background:var(--butter);}
  .guide-grid .feature-tile:nth-child(3) {background:var(--sage);}
</style>
