---
import Base from '../layouts/Base.astro';
import {path} from '../lib/format';
---
<Base title="Share a place" description="Open a draft for the location or shop link you shared." noindex>
  <div class="shell">
    <header class="page-head"><h1>Share a place</h1><p>On Android, install the atlas from Chrome and look for Mutta Puffs in the Maps share sheet. If it’s missing, copy the shop link from Maps and paste it into a draft.</p></header>
    <a href={path('contribute/#paste-link')} class="button">Paste a Maps link</a>
  </div>
</Base>
