---
import Base from '../layouts/Base.astro';
import {atlas, byId} from '../lib/catalogue';
import {formatNumber, locality, path, placePath} from '../lib/format';
const {ranking, policy} = atlas.leaderboard;
const categories = {pastry:'Pastry and flakiness', filling:'Masala and filling', egg:'Egg quality', freshness:'Freshness', value:'Value for money'};
---
<Base title="Puff Leaderboard" description="See egg puffs ranked by dated, first-hand community reviews and learn how the Puff Score works.">
  <div class="shell">
    <header class="page-head"><p class="kicker">Community tasting notes</p><h1>Puff Leaderboard</h1><p>Rankings come from people who tried the puff. A place enters the leaderboard after {policy.minimum_reviews} approved reviews.</p></header>
    {ranking.length ? <ol class="stack-list ranks">{ranking.map(row => {
      const place = byId.get(row.place_id)!;
      return <li class="panel"><div><h2><a href={placePath(place.id)}>{place.name}</a></h2><p class="muted">{locality(place.location)} · {row.count} approved reviews</p></div><strong>{formatNumber(row.adjusted)} <small>/ 100</small></strong></li>;
    })}</ol> : <section class="panel empty-panel"><h2>The first rankings are still baking</h2><p>{atlas.stats.reviews ? 'Approved reviews appear on each place page as they come in.' : 'There are no approved reviews yet.'} Tried a puff recently? Share what it tasted like.</p><a class="button" href={path('contribute/?kind=review')}>Review a puff</a></section>}
    <section class="section prose">
      <h2>How Puff Score works</h2>
      <p>Each review rates five parts of the puff on a scale from 1 to 10. A place page shows the weighted average out of 100 and how many reviews it has.</p>
      <dl class="score-weights">{Object.entries(policy.weights).map(([key, weight]) => <div><dt>{categories[key as keyof typeof categories]}</dt><dd>{weight}%</dd></div>)}</dl>
      <p>For ranking, the atlas blends each place’s average with a starting value of {policy.prior_score} out of 100, weighted like {policy.prior_reviews} reviews. As more people review a puff, the published reviews contribute more to its rank. The starting value is part of the formula and adds zero community reviews to the count.</p>
      <p><a href={path('api/v1/leaderboard.json')}>Download rankings and scoring rules</a></p>
    </section>
  </div>
</Base>
<style>
  .ranks {padding-inline-start:2rem;}
  .ranks li {margin-block:.65rem;}
  .ranks li::marker {font-weight:800;color:var(--pine);}
  .ranks h2 {font-size:1.35rem;}
  .ranks strong {font:700 1.8rem var(--display);color:var(--pine);}
  .ranks small {font:700 .9rem var(--body);}
  .score-weights {display:grid;max-width:28rem;gap:.35rem;}
  .score-weights div {display:flex;justify-content:space-between;gap:1rem;border-block-end:1px solid var(--line);}
  .score-weights dd {font-weight:800;margin:0;}
</style>
