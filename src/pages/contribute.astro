---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {atlas} from '../lib/catalogue';
import {github} from '../lib/format';
import {communityConfigured} from '../lib/community';
const forms = [
  {key:'place',title:'Add a puff spot'}, {key:'correction',title:'Correct a listing'},
  {key:'review',title:'Review an egg puff'}, {key:'observation',title:'Report a price or fresh batch'},
  {key:'photo',title:'Share a photo'}, {key:'heritage',title:'Share a bakery story'},
];
const places = atlas.places.slice().sort((a,b)=>a.name.localeCompare(b.name));
const scores = [['pastry','Pastry and flakiness'],['filling','Masala and filling'],['egg','Egg quality'],['freshness','Freshness'],['value','Value for money']];
---
<Base title="Contribute" section="Contribute" description="Share a new puff spot, a correction, a dated report, an original photo, or a bakery story.">
  <div class="shell">
    <header class="page-head"><p class="kicker">Contribute</p><h1>Share what you found.</h1><p>Add a puff spot, rate one you tried, or update a listing. Review your draft before {communityConfigured ? 'sending it for review.' : 'posting on GitHub.'}</p></header>
    <div class="contribute-grid">
      <form class="panel" data-contribution data-github={github}>
        <p data-import-status class="import-status" role="status"></p>
        <label class="field">I want to <select id="kind">{forms.map(form => <option value={form.key}>{form.title}</option>)}</select></label>
        <div class="contribution-fields" data-capture>
          <div class="share-paste" id="paste-link">
            <label class="field">Paste a Maps link or pin <textarea data-share-paste maxlength="2000" rows="2" aria-describedby="paste-help"></textarea></label>
            <p id="paste-help" class="muted">In Maps, choose Share and copy the link.</p>
            <div class="actions">
              <button type="button" class="button secondary small" data-import-share>Fill the draft</button>
              <button type="button" class="button secondary small" data-paste-clipboard hidden>Paste from clipboard</button>
            </div>
          </div>
          <div class="actions"><button class="button secondary" type="button" data-capture-location><Icon name="location" size={18} /> Use my current location</button></div>
          <p class="muted">Use device location when you’re at the public place you want to share.</p>
        </div>
        <div class="contribution-fields" data-kind="place">
          <label class="field">Shop or stall name <input name="place_name" maxlength="200" required /></label>
          <label class="field">City or neighbourhood <input name="area" maxlength="150" required /></label>
          <label class="field">Shop or map link <input name="map_link" type="url" maxlength="650" placeholder="https://…" required /></label>
          <label class="field">Notes from your visit <textarea name="details" maxlength="1000" placeholder="Where is it? What kind of egg puff did you find?" required></textarea></label>
        </div>
        <div class="contribution-fields" data-linked hidden>
          <label class="field">Atlas listing <select name="place_id" required>
            <option value="">Choose a place</option>{places.map(place => <option value={place.id}>{place.name}{place.location.city ? ' · ' + place.location.city : ''} · {place.id}</option>)}
          </select></label>
        </div>
        <fieldset class="contribution-fields" data-kind="correction" hidden disabled>
          <legend>Correction</legend>
          <label class="field">What needs to change? <textarea name="correction" maxlength="900" required placeholder="A corrected pin, shop name, or location detail"></textarea></label>
          <label class="field">Corrected pin or evidence link <input name="evidence" type="url" maxlength="650" placeholder="https://…" /></label>
          <label class="field">Date you checked the place <input name="verified_on" type="date" /><small>Include how you checked it in your correction.</small></label>
        </fieldset>
        <fieldset class="contribution-fields" data-kind="review" hidden disabled>
          <legend>Your puff review</legend>
          <label class="field">Visit date <input name="visited_on" type="date" required /></label>
          <p class="muted" id="rating-help">Each slider starts at 5. Check all five scores before continuing. 1 is poor and 10 is excellent.</p>
          <div class="rating-fields">{scores.map(([name,label]) => <div class="rating-field">
            <div class="rating-heading"><label for={'rating-' + name}>{label}</label><span data-rating-value aria-hidden="true">5 / 10</span></div>
            <input id={'rating-' + name} name={name} type="range" min="1" max="10" step="1" value="5" aria-describedby="rating-help" />
          </div>)}</div>
          <label class="field">Your first-hand notes <textarea name="review_note" maxlength="900" required></textarea></label>
        </fieldset>
        <fieldset class="contribution-fields" data-kind="observation" hidden disabled>
          <legend>What you observed</legend>
          <label class="field">Observation date <input name="observed_on" type="date" required /></label>
          <label class="field">Price per puff <input name="price" maxlength="35" placeholder="Amount and currency" /></label>
          <label class="field">Egg portion <select name="egg_portion"><option value="">Select if known</option><option>Whole egg</option><option>Half egg</option><option>Eggless</option><option>Other</option></select></label>
          <label class="field">Fresh batch times <input name="fresh_batch_times" maxlength="60" placeholder="16:00 local time" /></label>
          <label class="field">Availability <select name="availability"><option value="">Select if known</option><option>Available</option><option>Sold out</option><option>No longer sold</option></select></label>
        </fieldset>
        <fieldset class="contribution-fields" data-kind="photo" hidden disabled>
          <legend>Your original photo</legend>
          <p>{communityConfigured ? 'Add a public link to a photo you took.' : 'Attach a photo you took in the GitHub form or add a public link.'} Remove location metadata and keep identifiable people out of the frame.</p>
          <label class="field">Public image link <input name="photo_url" type="url" maxlength="650" required={communityConfigured} placeholder={communityConfigured ? 'https://…' : 'Optional if attaching on GitHub'} /></label>
          <label class="field">Describe the photo <textarea name="alt" maxlength="250" required placeholder="What should a reader know about the image?"></textarea></label>
          <label class="field">Photographer credit <input name="credit" maxlength="120" required /></label>
          <label class="field">Date taken <input name="captured_on" type="date" /></label>
        </fieldset>
        <fieldset class="contribution-fields" data-kind="heritage" hidden disabled>
          <legend>Bakery story</legend>
          <label class="field">Story title <input name="story_title" maxlength="120" required /></label>
          <label class="field">Your story <textarea name="story" maxlength="1800" required placeholder="Name the bakery or region and say how you know the story."></textarea></label>
          <label class="field">Reference or interview link <input name="story_source" type="url" maxlength="650" /></label>
        </fieldset>
        {communityConfigured && <label class="check"><input name="publication_consent" type="checkbox" required /> I can share this contribution under CC BY 4.0 and understand that approved entries are published openly.</label>}
        <p data-form-error role="alert"></p>
        <div class="actions">
          <button class="button" type="submit">{communityConfigured ? 'Send for review' : 'Continue on GitHub'} <Icon name={communityConfigured ? 'arrow' : 'external'} size={18} /></button>
          <button class="button secondary" type="button" data-save-draft>Save draft on this device</button>
          <button class="button secondary" type="button" data-clear-draft hidden>Remove saved draft</button>
          <button class="button secondary" type="button" data-undo-draft hidden>Undo draft removal</button>
        </div>
        <section class="github-draft" data-github-draft aria-labelledby="github-draft-title" hidden>
          <h2 id="github-draft-title">Your GitHub draft</h2>
          <p data-github-help></p>
          <div class="actions">
            <button type="button" class="button secondary small" data-copy-issue>Copy issue body</button>
            <a class="button secondary small" data-open-issue target="_blank" rel="noopener noreferrer">Open GitHub issue <Icon name="external" size={16} /></a>
          </div>
          <p data-copy-status role="status"></p>
          <details data-issue-preview>
            <summary>View issue body</summary>
            <label class="field">Issue body <textarea data-issue-body rows="8" readonly></textarea></label>
          </details>
        </section>
      </form>
      <aside class="panel">
        <section id="install">
          <h2>Install the atlas</h2>
          <p>To send a place from the Android share sheet, open the atlas in Chrome and choose <strong>Install app</strong>. Then share a shop or pin from Maps and select <strong>Mutta Puffs</strong>.</p>
          <button class="button secondary" type="button" data-install-app hidden>Install app</button>
          <p>Edge on Android can make a home-screen shortcut. If Mutta Puffs is missing from the share sheet, copy the Maps link and paste it into the form.</p>
          <p>On iPhone or iPad, use Safari’s Share menu to add the atlas to your Home Screen. Copy and paste Maps links to contribute.</p>
        </section>
        <h2>What to share</h2>
        <ul>
          <li>Use your own notes and dates from a visit.</li>
          <li>For a pin correction, share the public shop location and how you checked it.</li>
          <li>Leave personal addresses and contact details out of public submissions.</li>
        </ul>
        {communityConfigured && <section class="receipt-panel" aria-labelledby="receipt-heading">
          <h2 id="receipt-heading">Check a submission</h2>
          <p>Keep your receipt code to check the outcome without an account.</p>
          <form data-receipt>
            <label class="field">Receipt code <input name="receipt" type="text" autocomplete="off" autocapitalize="none" required /></label>
            <button class="button secondary small" type="submit">Check status</button>
          </form>
          <p class="live-note" data-receipt-status role="status"></p>
          <a data-publication-link hidden>Open the published record</a>
        </section>}
        <h2>Open an issue form</h2>
        <ul>{forms.map(form => <li><a href={github + '/issues/new?template=' + form.key + '.yml'}>{form.title}</a></li>)}</ul>
      </aside>
    </div>
  </div>
</Base>
<style>
  .contribute-grid {display:grid; grid-template-columns:minmax(0,1.65fr) minmax(0,1fr); gap:1rem; align-items:start;}
  .contribution-fields {display:grid; gap:.8rem; margin-block:1rem; padding:0; border:0; min-inline-size:0;}
  .github-draft {margin-block-start:1rem; padding-block-start:1rem; border-block-start:1px solid var(--line);}
  .github-draft h2 {font-size:1.4rem;}
  .github-draft p:not(:empty), .github-draft details {margin-block:.65rem;}
  .github-draft summary {cursor:pointer; font-weight:750;}
  .github-draft textarea {margin-block-start:.25rem;}
  legend {font-weight:800; margin-block-end:.55rem;}
  [data-form-error]:not(:empty) {margin-block:.55rem; color:var(--rust); font-weight:800;}
  .import-status:not(:empty) {margin-block-end:.85rem; padding:.6rem .7rem; border-radius:.5rem; background:var(--sage); color:var(--pine); font-weight:750;}
  .share-paste {display:grid; gap:.48rem; padding:.8rem; border:1px solid var(--line); border-radius:.65rem; background:var(--paper);}
  .share-paste textarea {min-block-size:4rem;}
  .rating-fields {display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,12rem),1fr)); gap:.7rem;}
  .rating-field {min-inline-size:0; padding:.65rem .8rem; border:1px solid var(--line); border-radius:.65rem;}
  .rating-heading {display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:.2rem .55rem;}
  .rating-heading label {font-weight:750;}
  .rating-heading span {color:var(--pine); font-weight:800; font-variant-numeric:tabular-nums;}
  .rating-field input {display:block; inline-size:100%; min-inline-size:0; block-size:2.75rem; accent-color:var(--pine); margin:0;}
  aside h2 {font-size:1.55rem;}
  .receipt-panel {margin-block-end:1.25rem;}
  aside p, aside button {margin-block:.7rem;}
  aside #install {padding-block-end:1rem; margin-block-end:1rem; border-block-end:1px solid var(--line);}
  aside ul {padding-inline-start:1.35rem;}
  @media (max-width:45rem) {.contribute-grid {grid-template-columns:minmax(0,1fr);}}
</style>
<script>
  import {browserPosition} from '../lib/distance';
  import {contributionDraft, pinLink} from '../lib/share';
  import {githubDraft, type ContributionKind} from '../lib/github-draft';
  import {track} from '../scripts/analytics';
  import {pagePlaceAliases, resolvePlaceId} from '../lib/place-identity';
  import {communityConfigured, communityRequest, type Receipt} from '../lib/community';
  const form = document.querySelector<HTMLFormElement>('[data-contribution]')!;
  const kind = form.querySelector<HTMLSelectElement>('#kind')!;
  const listing = form.querySelector<HTMLSelectElement>('[name=place_id]')!;
  const linked = form.querySelector<HTMLElement>('[data-linked]')!;
  const alert = form.querySelector<HTMLElement>('[data-form-error]')!;
  const notice = form.querySelector<HTMLElement>('[data-import-status]')!;
  const capture = form.querySelector<HTMLElement>('[data-capture]')!;
  const locate = form.querySelector<HTMLButtonElement>('[data-capture-location]')!;
  const paste = form.querySelector<HTMLTextAreaElement>('[data-share-paste]')!;
  const clipboard = form.querySelector<HTMLButtonElement>('[data-paste-clipboard]')!;
  const ratings = [...form.querySelectorAll<HTMLInputElement>('.rating-field input')];
  const saveButton = form.querySelector<HTMLButtonElement>('[data-save-draft]')!;
  const savedButton = form.querySelector<HTMLButtonElement>('[data-clear-draft]')!;
  const undoButton = form.querySelector<HTMLButtonElement>('[data-undo-draft]')!;
  const githubPanel = form.querySelector<HTMLElement>('[data-github-draft]')!;
  const githubHelp = form.querySelector<HTMLElement>('[data-github-help]')!;
  const copyIssue = form.querySelector<HTMLButtonElement>('[data-copy-issue]')!;
  const openIssue = form.querySelector<HTMLAnchorElement>('[data-open-issue]')!;
  const copyStatus = form.querySelector<HTMLElement>('[data-copy-status]')!;
  const issuePreview = form.querySelector<HTMLDetailsElement>('[data-issue-preview]')!;
  const issueBody = form.querySelector<HTMLTextAreaElement>('[data-issue-body]')!;
  const draftKey = 'mpdb-private-contribution-draft';
  let draftUndo: {previous: string; expected: string | null} | null = null;
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
  let sharedLink = '';
  let lastRequest: {signature: string; id: string; token: string} | null = null;
  let locationRequest = 0;
  const params = new URLSearchParams(location.search);
  if ([...kind.options].some(option => option.value === params.get('kind'))) kind.value = params.get('kind')!;
  const aliases = pagePlaceAliases();
  const requestedPlace = resolvePlaceId(params.get('place') ?? '', aliases);
  if ([...listing.options].some(option => option.value === requestedPlace)) listing.value = requestedPlace;
  const day = new Date();
  const localDate = [day.getFullYear(),String(day.getMonth() + 1).padStart(2,'0'),String(day.getDate()).padStart(2,'0')].join('-');
  for (const input of form.querySelectorAll<HTMLInputElement>('input[type=date]')) input.max = localDate;
  function showRating(input: HTMLInputElement) {
    input.parentElement!.querySelector('[data-rating-value]')!.textContent = input.value + ' / 10';
  }
  for (const input of ratings) input.addEventListener('input',() => showRating(input));
  function update() {
    for (const group of form.querySelectorAll<HTMLElement>('[data-kind]')) {
      group.hidden = group.dataset.kind !== kind.value;
      for (const input of group.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input,select,textarea')) input.disabled = group.hidden;
      if (group instanceof HTMLFieldSetElement) group.disabled = group.hidden;
    }
    linked.hidden = kind.value === 'place' || kind.value === 'heritage';
    listing.disabled = linked.hidden;
    capture.hidden = kind.value !== 'place' && kind.value !== 'correction';
    if (kind.value === 'correction' && sharedLink && !field('evidence')?.value) field('evidence')!.value = sharedLink;
    ratings.forEach(showRating);
    alert.textContent = '';
  }
  function fillDraft(draft: ReturnType<typeof contributionDraft>) {
    githubPanel.hidden = true;
    if (draft.link) {
      sharedLink = draft.link;
      const link = field(kind.value === 'correction' ? 'evidence' : 'map_link');
      if (link) link.value = draft.link;
    }
    if (kind.value === 'place') {
      if (draft.name && !field('place_name')?.value) field('place_name')!.value = draft.name;
      if (draft.details && !field('details')?.value) field('details')!.value = draft.details;
    }
    notice.textContent = draft.link ? 'Shared link added. Review the draft before continuing.' : 'No public link found. Paste a shop link or add a public pin.';
  }
  kind.addEventListener('change',() => {
    locationRequest++;
    githubPanel.hidden = true;
    locate.disabled = false;
    githubPanel.hidden = true;
    update();
  });
  form.querySelector('[data-import-share]')?.addEventListener('click',() => fillDraft(contributionDraft({text:paste.value})));
  clipboard.hidden = !navigator.clipboard?.readText;
  clipboard.addEventListener('click',async () => {
    clipboard.disabled = true;
    const requestedKind = kind.value;
    try {
      const text = await navigator.clipboard.readText();
      if (kind.value !== requestedKind) return;
      paste.value = text.slice(0,paste.maxLength);
      fillDraft(contributionDraft({text:paste.value}));
    } catch {
      if (kind.value === requestedKind) {
        notice.textContent = 'Paste the link directly into the field.';
        paste.focus();
      }
    } finally {
      clipboard.disabled = false;
    }
  });
  locate.addEventListener('click',async () => {
    const request = ++locationRequest;
    if (!navigator.geolocation) {
      notice.textContent = 'Device location is unavailable. Paste a public map link.';
      return;
    }
    locate.disabled = true;
    notice.textContent = 'Getting your location…';
    try {
      const [latitude,longitude] = await browserPosition(navigator.geolocation);
      if (request !== locationRequest) return;
      const link = pinLink(latitude,longitude);
      if (!link) throw new Error('Invalid position');
      fillDraft({name:'',link,details:''});
    } catch {
      if (request === locationRequest) notice.textContent = 'Could not get your location. Try again or paste a public map link.';
    } finally {
      if (request === locationRequest) locate.disabled = false;
    }
  });
  saveButton.addEventListener('click',() => {
    try {
      const previous = localStorage.getItem(draftKey);
      const draft = JSON.stringify({kind:kind.value,fields:Object.fromEntries(new FormData(form))});
      localStorage.setItem(draftKey,draft);
      if (previous && previous !== draft) draftUndo = {previous,expected:draft};
      undoButton.hidden = !draftUndo;
      undoButton.textContent = 'Undo draft replacement';
      savedButton.hidden = false;
      notice.textContent = previous && previous !== draft
        ? 'Saved draft replaced. You can undo the replacement before leaving this page.'
        : 'Draft saved on this device.';
    } catch {
      notice.textContent = 'This browser could not save the draft. Copy the details to keep them.';
    }
  });
  savedButton.addEventListener('click',() => {
    try {
      const draft = localStorage.getItem(draftKey);
      localStorage.removeItem(draftKey);
      draftUndo = draft ? {previous:draft,expected:null} : null;
      savedButton.hidden = true;
      undoButton.hidden = !draftUndo;
      undoButton.textContent = 'Undo draft removal';
      notice.textContent = draft === null ? 'There is no saved draft on this device.' : 'Saved draft removed. You can undo this before leaving the page.';
      (draft === null ? saveButton : undoButton).focus();
    } catch {
      notice.textContent = 'This browser could not remove the saved draft.';
    }
  });
  undoButton.addEventListener('click',() => {
    if (!draftUndo) return;
    try {
      if (localStorage.getItem(draftKey) !== draftUndo.expected) {
        notice.textContent = 'Another draft is already saved. The saved copy was kept.';
        return;
      }
      localStorage.setItem(draftKey,draftUndo.previous);
      draftUndo = null;
      undoButton.hidden = true;
      savedButton.hidden = false;
      notice.textContent = 'Saved draft restored.';
      savedButton.focus();
    } catch {
      notice.textContent = 'This browser could not restore the draft. Try undoing the removal again.';
    }
  });
  form.addEventListener('input',event => {
    alert.textContent = '';
    if (event.target instanceof Node && !githubPanel.contains(event.target)) githubPanel.hidden = true;
  });
  copyIssue.addEventListener('click',async () => {
    try {
      await navigator.clipboard.writeText(issueBody.value);
      copyStatus.textContent = 'Issue body copied. Paste it into the GitHub description if needed.';
    } catch {
      issuePreview.open = true;
      issueBody.focus();
      issueBody.select();
      copyStatus.textContent = 'Copy the selected text, then paste it into the GitHub description.';
    }
  });
  const receiptForm = document.querySelector<HTMLFormElement>('[data-receipt]');
  const receiptField = receiptForm?.querySelector<HTMLInputElement>('input') ?? null;
  const receiptStatus = document.querySelector<HTMLElement>('[data-receipt-status]');
  const publication = document.querySelector<HTMLAnchorElement>('[data-publication-link]');
  const sending = form.querySelector<HTMLButtonElement>('[type=submit]')!;
  receiptForm?.addEventListener('submit', async event => {
    event.preventDefault();
    if (!receiptField || !receiptStatus || !publication) return;
    const match = /^([a-f0-9-]{36})\.([A-Za-z0-9_-]{43})$/.exec(receiptField.value.trim());
    publication.hidden = true;
    if (!match) {receiptStatus.textContent = 'Enter the full receipt code.'; return;}
    receiptStatus.textContent = 'Checking submission…';
    try {
      const receipt = await communityRequest<Receipt>('v1/submissions/' + match[1], {token:match[2]});
      const messages: Record<Receipt['status'],string> = {
        pending:'Your submission is waiting for review.',
        approved:'Your submission is approved and waiting to be published.',
        rejected:'Your submission was declined.',
        published:'Your submission was published.',
      };
      receiptStatus.textContent = messages[receipt.status] + (receipt.reason ? ' ' + receipt.reason : '');
      if (receipt.reference && /^https:\/\/github\.com\/subtlesayak\/Mutta-Puffs-Database\/(issues|pull)\/\d+$/.test(receipt.reference)) {
        publication.href = receipt.reference;
        publication.hidden = false;
      }
    } catch (error) {
      receiptStatus.textContent = error instanceof Error ? error.message : 'Could not check this receipt.';
    }
  });
  form.addEventListener('submit',async event => {
    event.preventDefault();
    const data = new FormData(form);
    if (kind.value === 'observation' && !['price','egg_portion','fresh_batch_times','availability'].some(key => String(data.get(key) ?? '').trim())) {
      alert.textContent = 'Add at least one detail about price, egg portion, batch time, or availability.';
      return;
    }
    if (communityConfigured) {
      const consent = data.get('publication_consent') === 'on';
      data.delete('publication_consent');
      sending.disabled = true;
      try {
        const fields = Object.fromEntries([...data].filter(([,value])=>String(value).trim()));
        const submission = {kind:kind.value,fields,consent};
        const signature = JSON.stringify(submission);
        if (lastRequest?.signature !== signature) {
          const secret = crypto.getRandomValues(new Uint8Array(32));
          const token = btoa(String.fromCharCode(...secret)).replaceAll('+','-').replaceAll('/','_').replace(/=+$/,'');
          lastRequest = {signature,id:crypto.randomUUID(),token};
        }
        const {id,token} = lastRequest;
        const receipt = await communityRequest<Receipt & {token:string}>('v1/submissions',{
          method:'POST', body:{...submission,id,token},
        });
        const code = receipt.id + '.' + receipt.token;
        if (receiptField) receiptField.value = code;
        if (receiptStatus) receiptStatus.textContent = 'Submission received. Copy this receipt code to check it later.';
        notice.textContent = 'Sent for review. Keep your receipt code to check the outcome.';
        receiptField?.focus();
        receiptField?.select();
      } catch (error) {
        alert.textContent = error instanceof Error ? error.message : 'Could not send the contribution. You can save the draft and try again.';
      } finally {
        sending.disabled = false;
      }
      return;
    }
    const title = data.get('place_name') || data.get('story_title') || listing.selectedOptions[0]?.text.split(' · ')[0];
    const draft = githubDraft(form.dataset.github!,kind.value as ContributionKind,kind.selectedOptions[0].text + ': ' + title,data);
    issueBody.value = draft.body;
    openIssue.href = draft.href;
    copyStatus.textContent = '';
    githubHelp.textContent = draft.prefilled
      ? 'Review the draft in GitHub. If the description is empty after sign-in, copy the body below and paste it there.'
      : 'This draft is too long to fill through the link. Copy the body, open GitHub, and paste it into the description.';
    githubPanel.hidden = false;
    copyIssue.focus();
    track({name:'contribution_handoff',data:{kind:kind.value}});
    if (draft.prefilled) openIssue.click();
  });
  const anchor = new URL(location.href);
  const incoming = new URLSearchParams(anchor.hash.slice(1)).get('shared');
  const receivedShare = incoming !== null || anchor.hash === '#share-error';
  if (receivedShare) {
    anchor.hash = '';
    history.replaceState(null,'',anchor);
    try {
      if (!incoming) throw new Error('Share unavailable');
      kind.value = 'place';
      fillDraft(contributionDraft(JSON.parse(incoming)));
    } catch {
      notice.textContent = 'Could not open the shared draft. Copy the link and paste it here.';
    }
  }
  try {
    const saved = localStorage.getItem(draftKey);
    savedButton.hidden = !saved;
    if (saved && !receivedShare && !params.has('kind') && !params.has('place')) {
      const draft = JSON.parse(saved);
      if ([...kind.options].some(option => option.value === draft.kind)) kind.value = draft.kind;
      for (const [name,value] of Object.entries(draft.fields ?? {})) {
        const input = field(name);
        if (input && typeof value === 'string') input.value = name === 'place_id' ? resolvePlaceId(value, aliases) : value;
      }
      notice.textContent = 'Saved draft loaded from this device.';
    }
  } catch {}
  update();
</script>
