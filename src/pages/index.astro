---
import Base from '../layouts/Base.astro';
import Explore from '../components/Explore.astro';
import Icon from '../components/Icon.astro';
import {atlas} from '../lib/catalogue';
import {cityPath, formatNumber, path, placeCount} from '../lib/format';
const spotlight = atlas.cities.slice(0,4);
const stats = [[atlas.stats.places, 'Saved places'], [Object.keys(atlas.stats.countries).length, 'Countries'], [atlas.stats.states.Kerala ?? 0, 'In Kerala']];
---
<Base title="Explore" section="Explore" description="Find and share the world's best little bakery obsession. Browse the community-built atlas of Kerala-style egg puff spots.">
  <section class="shell hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="kicker"><span lang="ml">മുട്ട പഫ്സ്</span> <span aria-hidden="true">·</span> The egg puff atlas</p>
      <h1 id="hero-title">The world is full of <em>puffs.</em></h1>
      <p class="hero-deck">Find your next mutta puff, wherever you are. An atlas made by people who always want one more.</p>
      <form class="hero-search" action={path() + '#nearby'}>
        <label class="sr-only" for="hero-search">Search a bakery, city, or locality</label>
        <Icon name="search" size={19} />
        <input id="hero-search" name="q" type="search" placeholder="Bakery, city, or locality" />
        <button class="button" type="submit">Search <Icon name="arrow" size={17} /></button>
      </form>
      <div class="actions hero-actions">
        <a class="text-link" href="#find-nearby" data-find-nearby><Icon name="location" size={19} /> Find puffs near me</a>
        <a class="text-link" href={path('map/')}><Icon name="map" size={19} /> Open the map</a>
        <a class="text-link" href={path('roulette/')}>Try Puff Roulette <Icon name="arrow" size={17} /></a>
      </div>
    </div>
    <figure class="hero-visual">
      <img src={path('images/egg-puff.webp')} width="1536" height="1024" fetchpriority="high" alt="Golden Kerala egg puffs on an enamel plate, one split open to reveal egg and onion masala, with a glass of tea" />
      <figcaption>A Kerala bakery classic <small>Editorial illustration</small></figcaption>
    </figure>
  </section>
  <div class="shell stats-band" aria-label="Atlas coverage">
    <dl>{stats.map(([value,label]) => <div><dt>{label}</dt><dd>{formatNumber(Number(value))}</dd></div>)}</dl>
    <a class="text-link" href={path('insights/')}>Explore the data <Icon name="arrow" size={17} /></a>
  </div>
  <section class="shell section city-section" aria-labelledby="cities-title">
    <header class="heading city-head">
      <div><p class="kicker">Atlas by city</p><h2 id="cities-title">Where to start</h2></div>
      <div class="actions"><a class="text-link" href={path('trails/')}>Puff Trails</a><a class="text-link" href={path('cities/')}>All cities <Icon name="arrow" size={17} /></a></div>
    </header>
    <ul class="city-cards">
      {spotlight.map(city => <li>
        <a href={cityPath(city.id)}>
          <span class="city-pin"><Icon name="pin" size={21} /></span>
          <h3>{city.name}</h3>
          <p>{placeCount(city.count)}</p>
          <span class="city-arrow"><Icon name="arrow" size={20} /></span>
        </a>
      </li>)}
    </ul>
  </section>
  <Explore />
  <section class="shell contribute-band">
    <div><h2>Found a good puff?</h2><p>Help the next person find it. Share the bakery, what you paid, or when the fresh batch comes out.</p></div>
    <a class="button" href={path('contribute/')}>Contribute a place <Icon name="arrow" size={18} /></a>
  </section>
</Base>
<style>
  .hero { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.02fr); align-items: center; gap: clamp(1.5rem,5vw,4rem); margin-block: clamp(2.25rem,6vw,4.9rem) clamp(1.6rem,4vw,3rem); }
  .hero h1 { margin: .85rem 0; letter-spacing: -.065em; max-inline-size: 9.5ch; line-height: 1.01; }
  .hero h1 em { color: var(--rust); font-style: italic; font-weight: inherit; }
  .hero-deck { color: var(--muted); font-size: clamp(1rem,1.65vw,1.25rem); max-inline-size: 35ch; }
  .hero-search { display: grid; grid-template-columns: auto minmax(0,1fr) auto; align-items: center; gap: .55rem; margin-block-start: 1.5rem; border: 1px solid var(--control); background: var(--surface); border-radius: .8rem; padding: .4rem; padding-inline-start: .7rem; }
  .hero-search input { min-inline-size: 0; border: 0; background: transparent; color: var(--ink); padding: .45rem .15rem; }
  .hero-search input::placeholder { color: var(--muted); opacity: 1; }
  .hero-actions { margin-block-start: .65rem; column-gap: 1.25rem; }
  .hero-visual { margin: 0; overflow: hidden; border-radius: 1.05rem; background: var(--pine); color: var(--cream); }
  .hero-visual img { aspect-ratio: 1.2; inline-size: 100%; object-fit: cover; }
  .hero-visual figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .3rem 1rem; padding: .65rem 1rem; font-weight: 750; font-size: .89rem; }
  .hero-visual small { font-weight: 500; font-size: .78rem; }
  .stats-band { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .5rem 1rem; padding-block: 1.15rem; border-block: 1px solid var(--line); }
  .stats-band dl { display: flex; flex-wrap: wrap; margin: 0; gap: .65rem clamp(1rem, 5vw, 4rem); }
  .stats-band dl div { display: flex; align-items: baseline; gap: .55rem; flex-wrap: wrap; }
  .stats-band dt { color: var(--muted); font-weight: 750; }
  .stats-band dd { order: -1; margin: 0; color: var(--pine); font: 650 1.7rem/1.15 var(--display); }
  .city-head { display: flex; gap: .5rem; align-items: end; justify-content: space-between; flex-wrap: wrap; }
  .city-cards { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: .8rem; padding: 0; margin: 0; list-style: none; }
  .city-cards a { min-block-size: 9rem; display: grid; grid-template-columns: 1fr auto; gap: .35rem; align-items: center; padding: 1rem; background: var(--sage); color: var(--pine); border-radius: .8rem; text-decoration: none; }
  .city-cards li:nth-child(even) a { background: var(--butter); }
  .city-cards a:hover h3 { text-decoration: underline; }
  .city-cards h3 { grid-column: 1 / -1; overflow-wrap: anywhere; }
  .city-pin, .city-arrow { grid-column: 1 / -1; }
  .city-arrow { grid-column: 2; grid-row: 3; }
  .city-cards p { font-size: .87rem; font-weight: 700; }
  .contribute-band { padding: clamp(1.2rem, 4vw, 2.2rem); background: var(--butter); border-radius: var(--round); display: flex; align-items: center; gap: 1rem; justify-content: space-between; flex-wrap: wrap; }
  .contribute-band p { margin-block-start: .5rem; }
  @media (max-width: 48rem) { .hero { grid-template-columns: 1fr; } .hero h1 { max-inline-size: 13ch; } .hero-visual img { aspect-ratio: 1.55; } .city-cards { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 24rem) {
    .hero-search { grid-template-columns: minmax(0,1fr) auto; }
    .hero-search > :global(svg), .hero-search .button :global(svg) { display: none; }
    .stats-band dl div { flex-direction: column; gap: .2rem; }
    .stats-band dt { font-size: .85rem; }
  }
</style>
