---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MetricFilters from '../components/MetricFilters.astro';
import {atlas} from '../lib/catalogue';
import {accuracyLabels, cityPath, path, placeCount, placePath, verificationLabels} from '../lib/format';
const cities = atlas.cities.filter(city => city.centre).sort((a,b) => a.name.localeCompare(b.name));
const mapped = atlas.places.filter(place => place.location.latitude !== null).sort((a,b) => a.name.localeCompare(b.name));
const key = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY?.trim();
const mapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID?.trim();
const hasGoogleMap = Boolean(key && mapId);
const regions = [...new Set(mapped.flatMap(place => [place.location.state,place.location.country]).filter(Boolean))].sort();
const districts = [...new Set(mapped.flatMap(place => place.location.district ? [[place.location.district,place.location.state].filter(Boolean).join(' · ')] : []))].sort();
---
<Base title="Puff Map" section="Puff Map" description="Explore the worldwide egg puff atlas with clustered pins, city maps, and clearly labeled coordinate accuracy.">
  <div class="shell">
    <header class="page-head">
      <p class="kicker">The Puff Atlas</p>
      <h1>Puff Map</h1>
      <p>Zoom into a cluster or choose a city to see the places nearby. Estimated pins mark a general area.</p>
    </header>
    <div data-atlas-map data-google-key={hasGoogleMap ? key : undefined} data-google-id={hasGoogleMap ? mapId : undefined}>
      <form class="panel" aria-label="Map filters">
        <div class="map-filters">
        <label class="field">View <select name="view"><option value="map">Map</option><option value="list">List</option></select></label>
        {hasGoogleMap && <label class="field">Base map <select name="renderer"><option value="atlas">Atlas map</option><option value="google">Google Maps</option></select></label>}
        <label class="field">City <select name="city"><option value="">All cities</option>{cities.map(city => <option value={city.id}>{city.name}</option>)}</select></label>
        <label class="field">State or country <select name="region"><option value="">All regions</option>{regions.map(region => <option>{region}</option>)}</select></label>
        <label class="field">Indian district <select name="district"><option value="">All districts</option>{districts.map(district => <option>{district}</option>)}</select></label>
        <label class="field">Puff trail <select name="trail"><option value="">All places</option>{atlas.trails.map(trail => <option value={trail.id}>{trail.name}</option>)}</select></label>
        <label class="field">Coordinate accuracy <select name="accuracy"><option value="">All pins</option>{Object.entries(accuracyLabels).filter(([v])=>v !== 'unknown').map(([key,label]) => <option value={key}>{label}</option>)}</select></label>
        <label class="field">Verification <select name="verification"><option value="">Any status</option>{Object.entries(verificationLabels).map(([value,label]) => <option value={value}>{label}</option>)}</select></label>
        <label class="field">Select a pin <select name="place"><option value="">Choose a place</option>{mapped.map(place => <option value={place.id}>{place.name}{place.location.city ? ' · ' + place.location.city : ''}</option>)}</select></label>
        <label class="check"><input type="checkbox" name="density" /> Show density</label>
        </div>
        <MetricFilters />
      </form>
      <p data-map-status class="map-status live-note" role="status">Loading the atlas map…</p>
      <div class="map-frame" data-map-frame>
        <div class="map-canvas" data-map-canvas aria-label="Interactive map of saved puff places"></div>
        {hasGoogleMap && <div class="map-canvas" data-google-canvas aria-label="Google map of saved puff places" hidden></div>}
        <div class="map-legend" data-pins-key><span></span> Saved places <span></span> Cluster</div>
        <div class="map-legend" data-density-key hidden>Density of saved places</div>
      </div>
      <ul class="place-grid" data-map-list hidden></ul>
      <div class="map-selection" data-selection aria-live="polite"></div>
    </div>
    <p class="map-note">The basemap uses locally hosted Natural Earth outlines. Open a place in your preferred maps app for street-level directions.</p>
    <div class="actions">
      <a class="text-link" href={path('#nearby')}><Icon name="arrow" size={18} /> Search the place list</a>
      <a class="text-link" href={path('cities/')}>Browse city directories</a>
    </div>
    <details class="map-index">
      <summary>Browse mappable places without using the map</summary>
      <ul>{mapped.map(place => <li><a href={placePath(place.id)}>{place.name}</a> <span class="muted">{place.location.city}</span></li>)}</ul>
    </details>
    <noscript><p class="muted">The map needs JavaScript. Explore a city directory instead.</p><ul>{atlas.cities.slice(0,5).map(city => <li><a href={cityPath(city.id)}>{city.name} · {placeCount(city.count)}</a></li>)}</ul></noscript>
  </div>
</Base>
<style>
  .map-filters { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,10rem),1fr)); gap: .9rem; align-items: end; }
  .map-frame { position: relative; background: #e4ebdf; border: 1px solid var(--line); border-radius: 1rem; overflow: hidden; }
  .map-canvas { height: min(70vh,41rem); min-height: 22rem; }
  .map-legend { display: flex; align-items: center; gap: .38rem; position: absolute; bottom: 1.75rem; left: .7rem; padding: .38rem .6rem; border-radius: .45rem; background: var(--surface); font-size: .78rem; pointer-events: none; }
  .map-legend span { display: inline-block; inline-size: .58rem; block-size: .58rem; background: var(--rust); border-radius: 50%; }
  .map-legend span:nth-child(2) { inline-size: .88rem; block-size: .88rem; background: var(--pine); margin-inline-start: .34rem; }
  .map-note, .map-index, .map-selection:not(:empty) { margin-block-start: .75rem; }
  .map-note { font-size: .875rem; color: var(--muted); }
  .map-index summary { cursor: pointer; font-weight: 800; }
  @media (max-width: 48rem) { .map-filters {grid-template-columns: repeat(2,minmax(0,1fr));} }
  @media (max-width: 30rem) { .map-filters {grid-template-columns: 1fr;} }
</style>
<script>
  import 'maplibre-gl/dist/maplibre-gl.css';
  import {startMap} from '../scripts/atlas-map';
  void startMap();
</script>
