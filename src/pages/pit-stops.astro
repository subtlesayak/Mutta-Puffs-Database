---
import Base from '../layouts/Base.astro';
---
<Base title="Puff Pit Stops" description="Find saved egg puff stops near a GPX route using the community atlas.">
  <div class="shell" data-pit-stops>
    <header class="page-head">
      <h1>Puff Pit Stops</h1>
      <p>Find puff spots along a walking, cycling or driving route. The GPX file stays on this device.</p>
    </header>
    <form class="panel route-form">
      <label class="field">GPX route or track
        <input type="file" name="route" accept=".gpx,application/gpx+xml" required />
        <small>Use an exported route or track up to 2 MB.</small>
      </label>
      <label class="field">Search distance
        <select name="distance"><option value=".5">0.5 km from the route</option><option value="1">1 km from the route</option><option value="2" selected>2 km from the route</option><option value="5">5 km from the route</option><option value="10">10 km from the route</option></select>
      </label>
      <button class="button" type="submit">Find pit stops</button>
    </form>
    <noscript><p>Enable JavaScript to read the GPX file on this device.</p></noscript>
    <p class="live-note" data-route-status role="status"></p>
    <ul class="place-grid" data-route-results></ul>
  </div>
</Base>
<style>
  .route-form { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(0,1fr) auto; align-items:start; gap:.9rem; }
  .route-form button { margin-block-start:1.95rem; }
  @media (max-width:46rem) {
    .route-form { grid-template-columns:minmax(0,1fr); }
    .route-form button { margin:0; justify-self:start; }
  }
</style>
<script>
  import {nearestRoutePoint,readGpx,routeSegments} from '../lib/routes';
  import {formatNumber,locality,path,placeCount,placePath} from '../lib/format';
  import type {Place} from '../lib/types';

  const root = document.querySelector<HTMLElement>('[data-pit-stops]')!;
  const form = root.querySelector<HTMLFormElement>('form')!;
  const input = form.elements.namedItem('route') as HTMLInputElement;
  const radius = form.elements.namedItem('distance') as HTMLSelectElement;
  const submit = form.querySelector<HTMLButtonElement>('button')!;
  const status = root.querySelector<HTMLElement>('[data-route-status]')!;
  const list = root.querySelector<HTMLElement>('[data-route-results]')!;
  let places: Place[] | undefined;

  form.addEventListener('submit',async event => {
    event.preventDefault();
    const file = input.files?.[0];
    if (!file) return;
    submit.disabled = true;
    list.replaceChildren();
    status.textContent = 'Checking stops along your route…';
    try {
      if (file.size > 2 * 1024 * 1024) throw new Error('Choose a GPX file smaller than 2 MB.');
      const route = routeSegments(readGpx(await file.text()));
      if (!route.length) throw new Error('The route needs at least two different coordinates.');
      if (!places) {
        const response = await fetch(path('api/v1/places.json'));
        if (!response.ok) throw new Error('Could not load the atlas. Try again when online.');
        ({places} = await response.json());
      }
      const limit = Number(radius.value);
      const nearby = (places ?? []).flatMap(place => {
        const {latitude,longitude} = place.location;
        if (latitude === null || longitude === null) return [];
        const closest = nearestRoutePoint([latitude,longitude],route);
        return closest.offset <= limit ? [{place,...closest}] : [];
      }).sort((a,b) => a.distanceAlong - b.distanceAlong || a.offset - b.offset);
      status.textContent = nearby.length
        ? placeCount(nearby.length) + ' along the route. Distances are approximate and use the atlas pins.'
        : 'No saved places within ' + limit + ' km. Try a wider search distance.';
      for (const {place,offset,distanceAlong} of nearby) {
        const item = document.createElement('li');
        item.className = 'place-card';
        const heading = document.createElement('h2');
        const link = document.createElement('a');
        link.href = placePath(place.id);
        link.textContent = place.name;
        heading.append(link);
        const area = document.createElement('p');
        area.className = 'muted';
        area.textContent = locality(place.location);
        const distance = document.createElement('p');
        distance.textContent = formatNumber(Math.round(distanceAlong * 10) / 10) + ' km along · ' +
          formatNumber(Math.round(offset * 10) / 10) + ' km off route';
        item.append(heading,area,distance);
        list.append(item);
      }
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Could not read this GPX file.';
    } finally {
      submit.disabled = false;
    }
  });
</script>
