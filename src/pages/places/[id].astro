---
import PlaceDetail from '../../components/PlaceDetail.astro';
import {placePages} from '../../lib/catalogue';
import {placePath} from '../../lib/format';
import type {Place} from '../../lib/types';

export function getStaticPaths() {
  return placePages.map(({id,props}) => ({params:{id},props}));
}
interface Props {place: Place; redirectTo?: string}
const {place,redirectTo} = Astro.props;
if (redirectTo) return Astro.redirect(placePath(redirectTo),301);
---
<PlaceDetail place={place} />
