---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import {atlas, byId} from '../../lib/catalogue';
import type {City} from '../../lib/types';
import {path, placeCount} from '../../lib/format';

export function getStaticPaths() {
  return atlas.cities.map(city => ({params: {id: city.id}, props: {city}}));
}
interface Props {city: City}
const {city} = Astro.props;
const places = city.place_ids.map(id => byId.get(id)!).sort((a,b) => a.name.localeCompare(b.name));
---
<Base title={'Egg puffs near ' + city.name} section="Cities" description={'Discover ' + placeCount(city.count) + ' saved near ' + city.name + ', with community notes, coordinate accuracy, and map links.'}>
  <div class="shell">
    <header class="page-head">
      <a class="text-link" href={path('cities/')}>All cities</a>
      <h1>Egg puffs near {city.name}</h1>
      <p>{placeCount(city.count)} · {[city.state,city.country].filter(Boolean).join(', ') || 'Community city directory'}</p>
      <div class="actions city-actions">
        <a class="button" href={path('map/?city=' + city.id)}><Icon name="map" size={18} /> View city map</a>
        {city.centre && <a class="button secondary" href={path('?city=' + city.id + '#nearby')}><Icon name="location" size={18} /> Search near {city.name}</a>}
      </div>
    </header>
    <ul class="place-grid">{places.map(place => <PlaceCard place={place} />)}</ul>
  </div>
</Base>
<style>.city-actions {margin-block-start: 1.15rem;}</style>
