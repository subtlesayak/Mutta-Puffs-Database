---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import {atlas, byId} from '../../lib/catalogue';
import {path} from '../../lib/format';
---
<Base title="Puff Trails" description="Plan a bakery outing with ordered puff stops selected from the crowdsourced atlas.">
  <div class="shell">
    <header class="page-head"><p class="kicker">Bakery outings</p><h1>Puff Trails</h1><p>Pick a city and make an afternoon of it. The stops are drawn from the community’s saved places.</p></header>
    <ul class="tile-grid">
      {atlas.trails.map(trail => <li class="panel feature-tile">
        <p class="kicker">{byId.get(trail.place_ids[0])?.location.city} · {trail.place_ids.length} stops</p>
        <h2>{trail.name}</h2>
        <p>{trail.description}</p>
        <a class="text-link" href={path('trails/' + trail.id + '/')} aria-label={'See stops for ' + trail.name}>See the stops <Icon name="arrow" size={16} /></a>
      </li>)}
    </ul>
  </div>
</Base>
