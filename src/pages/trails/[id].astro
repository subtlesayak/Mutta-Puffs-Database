---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import {atlas, byId} from '../../lib/catalogue';
import {accuracyLabels, locality, path, placePath, providerLabels} from '../../lib/format';
import type {Trail, Provider} from '../../lib/types';
export function getStaticPaths() {
  return atlas.trails.map(trail => ({params:{id:trail.id},props:{trail}}));
}
interface Props {trail: Trail}
const {trail} = Astro.props;
const stops = trail.place_ids.map(id => byId.get(id)!);
---
<Base title={trail.name} description={trail.description}>
  <div class="shell">
    <header class="page-head">
      <a class="text-link" href={path('trails/')}>All puff trails</a>
      <p class="kicker">{stops.length} saved stops</p><h1>{trail.name}</h1><p>{trail.description}</p>
      <div class="actions"><a class="button" href={path('map/?trail=' + trail.id)}><Icon name="map" size={18} /> Show stops on the map</a></div>
    </header>
    <p class="muted trail-note">These suggested stops come from the archive. Check the shop and its current puff availability before making the trip.</p>
    <ol class="trail-stops">
      {stops.map(place => <li class="panel">
        <h2><a href={placePath(place.id)}>{place.name}</a></h2><p class="muted">{locality(place.location)}</p>
        <p><span class="tag">{accuracyLabels[place.location.accuracy]}</span></p>
        <div class="actions">{(Object.entries(place.map_links) as [Provider,string][]).map(([provider,link]) => <a class="text-link" data-directions={provider} href={link} target="_blank" rel="noopener noreferrer" aria-label={place.name + ' in ' + providerLabels[provider]}>{providerLabels[provider]} <Icon name="external" size={15} /></a>)}</div>
      </li>)}
    </ol>
  </div>
</Base>
<style>
  .trail-note {max-width:65ch;}
  .trail-stops {display:grid;gap:.8rem;padding-inline-start:2rem;}
  .trail-stops li::marker {color:var(--pine);font:700 1.35rem var(--display);}
  .trail-stops h2 {font-size:1.45rem;}
  .trail-stops p {margin-block-start:.35rem;}
</style>
