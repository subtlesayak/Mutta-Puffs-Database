---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import MetricFilters from './MetricFilters.astro';
import {atlas} from '../lib/catalogue';
import {cityPath, localizedPath, placePath} from '../lib/format';
import {labelSets, type Locale} from '../lib/locales';
import {directoryCopy, directoryCount} from '../lib/directory-copy';
import {finderCopy} from '../lib/finder-copy';
import {mapCopy, type MapRuntimeCopy} from '../lib/map-copy';
import {translatedDistrict, translatedPlaceName} from '../lib/place-search';

interface Props {locale?: Locale}
const {locale = 'en'} = Astro.props;
const labels = labelSets[locale];
const copy = mapCopy[locale];
const finder = finderCopy[locale];
const localName = (name: string) => translatedPlaceName(name,locale);
const runtime: MapRuntimeCopy = {
  ...copy.status,controls:copy.controls,atlasCanvas:copy.atlasCanvas,
  accuracy:finder.accuracy,allDistricts:labels.allDistricts,choosePlace:copy.selectPin,
  placeOne:directoryCopy[locale].onePlace,placeMany:labels.places,
};
const cities = atlas.cities.filter(city => city.centre).sort((a,b) => a.name.localeCompare(b.name));
const mapped = atlas.places.filter(place => place.location.latitude !== null).sort((a,b) => a.name.localeCompare(b.name));
const key = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY?.trim();
const mapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID?.trim();
const hasGoogleMap = Boolean(key && mapId);
const regions = [...new Set(mapped.flatMap(place => [place.location.state,place.location.country]).filter((name): name is string => Boolean(name)))].sort();
const districts = [...new Set(mapped.flatMap(place => place.location.district ? [[place.location.district,place.location.state].filter(Boolean).join(' · ')] : []))].sort();
---
<Base title={labels.map} section="Puff Map" description={copy.description} locale={locale} languageRoute="map/">
  <div class="shell">
    <header class="page-head">
      <h1>{labels.map}</h1>
      <p>{copy.intro}</p>
    </header>
    <div data-atlas-map data-map-copy={JSON.stringify(runtime)} data-google-key={hasGoogleMap ? key : undefined} data-google-id={hasGoogleMap ? mapId : undefined}>
      <form class="panel" aria-label={labels.map + ' · ' + copy.filters}>
        <div class="map-quick">
          <label class="field">{copy.view} <select name="view"><option value="map">{copy.map}</option><option value="list">{copy.list}</option></select></label>
          <label class="field">{copy.city} <select name="city"><option value="">{copy.allCities}</option>{cities.map(city => <option value={city.id}>{localName(city.name)}</option>)}</select></label>
        </div>
        <details class="map-disclosure">
          <summary>{copy.filters}<span data-map-filter-count></span></summary>
          <div class="map-filters">
            <label class="field">{copy.basemap} <select name="renderer"><option value="atlas">{copy.offline}</option><option value="street">{copy.streets}</option>{hasGoogleMap && <option value="google">Google Maps</option>}</select></label>
            <label class="field">{labels.region} <select name="region"><option value="">{labels.allRegions}</option>{regions.map(region => <option value={region}>{localName(region)}</option>)}</select></label>
            <label class="field">{labels.district} <select name="district"><option value="">{labels.allDistricts}</option>{districts.map(district => <option value={district}>{translatedDistrict(district,locale)}</option>)}</select></label>
            <label class="field">{copy.trail} <select name="trail"><option value="">{copy.allPlaces}</option>{atlas.trails.map(trail => <option value={trail.id}>{trail.name}</option>)}</select></label>
            <label class="field">{copy.accuracy} <select name="accuracy"><option value="">{copy.pins}</option>{Object.entries(finder.accuracy).filter(([v])=>v !== 'unknown').map(([key,label]) => <option value={key}>{label}</option>)}</select></label>
            <label class="field">{labels.verification} <select name="verification"><option value="">{labels.anyStatus}</option>{Object.entries(finder.verification).map(([value,label]) => <option value={value}>{label}</option>)}</select></label>
            <label class="field">{copy.selectPin} <select name="place"><option value="">{runtime.choosePlace}</option>{mapped.map(place => <option value={place.id}>{place.name}{place.location.city ? ' · ' + localName(place.location.city) : ''}</option>)}</select></label>
            <label class="check"><input type="checkbox" name="density" /> {copy.showDensity}</label>
          </div>
          <MetricFilters collapsible={false} locale={locale} />
          <button type="reset" class="button secondary small map-reset">{labels.clear}</button>
        </details>
      </form>
      <p data-map-status class="map-status live-note" role="status">{copy.status.loading}</p>
      <div class="map-frame" data-map-frame>
        <div class="map-canvas" data-map-canvas></div>
        {hasGoogleMap && <div class="map-canvas" data-google-canvas role="region" aria-label={copy.googleCanvas} hidden></div>}
        <div class="map-legend" data-pins-key><span></span> {copy.savedPlaces} <span></span> {copy.cluster}</div>
        <div class="map-legend" data-density-key hidden>{copy.density}</div>
        <a class="map-attribution" data-street-attribution href="https://www.openstreetmap.org/copyright" hidden>{copy.attribution}</a>
      </div>
      <ul class="place-grid" data-map-list hidden></ul>
      <div class="map-selection" data-selection aria-live="polite"></div>
    </div>
    <p class="map-note">{copy.tileNote}</p>
    <div class="actions">
      <a class="text-link" href={localizedPath('#nearby',locale)}><Icon name="arrow" size={18} /> {copy.searchList}</a>
      <a class="text-link" href={localizedPath('cities/',locale)}>{finder.cityDirectory}</a>
    </div>
    <details class="map-index">
      <summary>{copy.index}</summary>
      <ul>{mapped.map(place => <li><a href={placePath(place.id,locale)}>{place.name}</a> <span class="muted">{place.location.city && localName(place.location.city)}</span></li>)}</ul>
    </details>
    <noscript><p class="muted">{copy.noScript}</p><ul>{atlas.cities.slice(0,5).map(city => <li><a href={cityPath(city.id,locale)}>{localName(city.name)} · {directoryCount(city.count,locale)}</a></li>)}</ul></noscript>
  </div>
</Base>
<style>
  .map-quick { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); max-inline-size: 26rem; gap: .9rem; }
  .map-disclosure { margin-block-start: .55rem; }
  .map-disclosure summary { width: fit-content; min-block-size: 2.75rem; align-content: center; cursor: pointer; font-weight: 800; }
  [data-map-filter-count] { color: var(--muted); font-size: .875rem; font-weight: 650; }
  .map-filters { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,10rem),1fr)); gap: .9rem; align-items: end; }
  .map-reset { margin-block-start: .75rem; }
  .map-frame { position: relative; background: #e4ebdf; border: 1px solid var(--line); border-radius: 1rem; overflow: hidden; }
  .map-canvas { height: min(70vh,41rem); min-height: 22rem; }
  .map-canvas :global(.maplibregl-canvas:focus-visible) { outline-offset: -5px; }
  .map-legend { display: flex; flex-wrap: wrap; align-items: center; gap: .38rem; position: absolute; inset: auto .7rem 1.75rem; inline-size: fit-content; max-inline-size: calc(100% - 1.4rem); padding: .38rem .6rem; border-radius: .45rem; background: var(--surface); font-size: .78rem; pointer-events: none; }
  .map-attribution {
    position:absolute; inset-block-end:.4rem; inset-inline-end:.55rem; padding:.15rem .4rem;
    border-radius:.3rem; background:var(--surface); font-size:.78rem; font-weight:700;
  }
  .map-legend span { display: inline-block; inline-size: .58rem; block-size: .58rem; background: var(--rust); border-radius: 50%; }
  .map-legend span:nth-child(2) { inline-size: .88rem; block-size: .88rem; background: var(--pine); margin-inline-start: .34rem; }
  .map-note, .map-index, .map-selection:not(:empty) { margin-block-start: .75rem; }
  .map-note { font-size: .875rem; color: var(--muted); }
  .map-index summary { cursor: pointer; font-weight: 800; }
  @media (max-width: 48rem) { .map-filters {grid-template-columns: repeat(2,minmax(0,1fr));} }
  @media (max-width: 30rem) { .map-filters {grid-template-columns: 1fr;} }
</style>
<script>
  import 'maplibre-gl/dist/maplibre-gl.css';
  import {startMap} from '../scripts/atlas-map';
  void startMap();
</script>
