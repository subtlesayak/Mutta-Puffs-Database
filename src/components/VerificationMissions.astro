---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import {atlas} from '../lib/catalogue';
import {localizedPath,locality,placePath} from '../lib/format';
import {placeMissions, missionDraftRoute, missionTypes} from '../lib/verification-missions';
import {missionCopy} from '../lib/mission-copy';
import {finderCopy} from '../lib/finder-copy';
import {translatedPlaceName} from '../lib/place-search';
import type {Locale} from '../lib/locales';
interface Props {locale?: Locale}
const {locale = 'en'} = Astro.props;
const copy = missionCopy[locale];
const finder = finderCopy[locale];
const localName = (name: string) => translatedPlaceName(name,locale);
const tasks = atlas.places.flatMap(place => placeMissions(place).map(mission => ({place,mission})));
const areas = [...new Set(tasks.flatMap(({place}) => [place.location.city,place.location.district]).filter((value): value is string => Boolean(value)))].sort();
---
<Base title={copy.title} description={copy.intro} section="Puff Guide" locale={locale} languageRoute="missions/">
  <div class="shell" data-missions data-mission-copy={JSON.stringify(copy.status)}>
    <header class="page-head">
      <h1>{copy.title}</h1>
      <p>{copy.intro}</p>
    </header>
    <div class="panel mission-filters">
      <label class="field">{copy.area}
        <select name="area"><option value="">{copy.allAreas}</option>{areas.map(area => <option value={area}>{localName(area)}</option>)}</select>
      </label>
      <label class="field">{copy.mission}
        <select name="mission">{missionTypes.map(mission => <option value={mission}>{copy.labels[mission]}</option>)}</select>
      </label>
    </div>
    <p class="live-note" data-mission-count role="status"></p>
    <ul class="place-grid" data-mission-list>
      {tasks.map(({place,mission}) => (
        <li class="place-card" data-mission-card={mission} data-city={place.location.city} data-district={place.location.district} hidden={mission !== 'details'}>
          <h2><a href={placePath(place.id,locale)}>{place.name}</a></h2>
          <p class="muted">{locality(place.location,localName) || finder.locationPending}</p>
          {mission === 'pin' && <p class="muted">{finder.accuracy[place.location.accuracy]}</p>}
          <p>{copy.instructions[mission]}</p>
          <a class="text-link" href={localizedPath(missionDraftRoute(place.id,mission),locale)}>{copy.report} <Icon name="arrow" size={16} /></a>
        </li>
      ))}
    </ul>
    <noscript><p>{copy.noScript}</p></noscript>
  </div>
</Base>
<style>
  .mission-filters { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.8rem; }
  .place-card h2 { font-size:1.25rem; }
  @media (max-width:34rem) {.mission-filters {grid-template-columns:minmax(0,1fr);}}
</style>
<script>
  import {formatMessage} from '../lib/format';
  const root = document.querySelector<HTMLElement>('[data-missions]')!;
  const copy = JSON.parse(root.dataset.missionCopy!) as Record<'empty'|'one'|'many',string>;
  const locale = document.documentElement.lang;
  const numbers = new Intl.NumberFormat(locale);
  const plural = new Intl.PluralRules(locale);
  const area = root.querySelector<HTMLSelectElement>('[name=area]')!;
  const mission = root.querySelector<HTMLSelectElement>('[name=mission]')!;
  const status = root.querySelector<HTMLElement>('[data-mission-count]')!;
  const cards = [...root.querySelectorAll<HTMLElement>('[data-mission-card]')];
  const alternatives = document.querySelectorAll<HTMLAnchorElement>('#page-languages a');
  const url = new URL(location.href);
  for (const field of [area,mission]) {
    const value = url.searchParams.get(field.name);
    if (value && [...field.options].some(option => option.value === value)) field.value = value;
  }
  function filter() {
    let count = 0;
    for (const card of cards) {
      const nearby = !area.value || card.dataset.city === area.value || card.dataset.district === area.value;
      const matches = card.dataset.missionCard === mission.value;
      card.hidden = !nearby || !matches;
      if (!card.hidden) count++;
    }
    status.textContent = count ? formatMessage(copy[plural.select(count) === 'one' ? 'one' : 'many'],{count:numbers.format(count)}) : copy.empty;
    const params = new URLSearchParams();
    if (area.value) params.set('area',area.value);
    if (mission.value !== 'details') params.set('mission',mission.value);
    url.search = params.toString();
    history.replaceState(null,'',url);
    for (const link of alternatives) {
      const destination = new URL(link.href);
      destination.search = params.toString();
      link.href = destination.href;
    }
  }
  area.addEventListener('change',filter);
  mission.addEventListener('change',filter);
  filter();
</script>
