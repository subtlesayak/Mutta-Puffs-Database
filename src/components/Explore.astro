---
import {atlas} from '../lib/catalogue';
import {github, path, providerLabels, verificationLabels} from '../lib/format';
import Icon from './Icon.astro';
import MetricFilters from './MetricFilters.astro';
import PlaceCard from './PlaceCard.astro';

const areas = [...new Set(atlas.places.flatMap(p => [p.location.state, p.location.country]).filter((s): s is string => Boolean(s)))].sort();
const categories = [...new Set(atlas.places.map(p => p.category))].sort();
const cities = atlas.cities.filter(city => city.centre).sort((a,b) => a.name.localeCompare(b.name));
---
<section class="shell section" id="nearby" aria-labelledby="explore-title">
  <header class="heading">
    <p class="kicker">The directory</p>
    <h2 id="explore-title">Find a puff stop</h2>
    <p class="muted">Search the list, look around a city, or find the places closest to you.</p>
  </header>
  <div data-explorer class="explorer">
    <form class="panel" data-filters aria-label="Filter places">
      <div class="explore-top">
        <label class="field">Search places <input type="search" name="search" placeholder="Bakery, city, or neighbourhood" /></label>
        <label class="field">State or country <select name="region"><option value="">All regions</option>{areas.map(area => <option>{area}</option>)}<option value="unassigned">Country unassigned</option></select></label>
        <label class="field">Indian district <select name="district"><option value="">All districts</option></select></label>
        <label class="field">Verification <select name="verification"><option value="">Any status</option>{Object.entries(verificationLabels).map(([key,label]) => <option value={key}>{label}</option>)}</select></label>
      </div>
      <fieldset class="nearby-options">
        <legend>Find nearby</legend>
        <div class="nearby-grid">
          <button class="button" type="button" data-locate><Icon name="location" size={18} /> Use my location</button>
          <label class="field">Or choose a city <select name="city"><option value="">Select a city</option>
            {cities.map(city => <option value={city.id} data-centre={city.centre?.join(',')}>{city.name}</option>)}
          </select></label>
          <label class="field">Distance <select name="radius" disabled>
            <option value="5">5 km</option><option value="10">10 km</option><option value="25" selected>25 km</option>
            <option value="50">50 km</option><option value="100">100 km</option><option value="Infinity">Any distance</option>
          </select></label>
          <button class="button secondary" type="button" data-clear-location hidden>Clear location</button>
        </div>
        <p class="muted distance-help">Distances are straight-line estimates. Your device location stays in this tab.</p>
        <p data-location-status role="status"></p>
      </fieldset>
      <div class="explore-bottom">
        <label class="field">Place type <select name="category"><option value="">All types</option>{categories.map(category => <option>{category}</option>)}</select></label>
        <label class="field">Open places in <select name="provider">{Object.entries(providerLabels).map(([value,label]) => <option value={value}>{label}</option>)}</select></label>
        <label class="check"><input type="checkbox" name="notes" /> With contributor notes</label>
        <button type="reset" class="button secondary">Clear filters</button>
      </div>
      <MetricFilters />
    </form>
    <noscript><p class="muted">The filters need JavaScript. Browse the <a href={path('cities/')}>city directory</a> or the <a href={github + '/blob/main/analysis/PLACES.md'}>complete place list on GitHub</a>.</p></noscript>
    <div class="result-bar">
      <p class="muted" data-result-status role="status"></p>
      <a class="text-link" href={path('map/')}><Icon name="map" size={18} /> Map view</a>
    </div>
    <ul class="place-grid" data-results>{atlas.places.slice(0,6).map(place => <PlaceCard place={place} />)}</ul>
    <div class="actions pagination" data-pagination hidden>
      <button type="button" class="button secondary" data-previous>Previous</button>
      <span data-pages></span>
      <button type="button" class="button secondary" data-next>Next</button>
    </div>
  </div>
</section>

<style>
  .explore-top { display: grid; grid-template-columns: minmax(0,1.4fr) repeat(3,minmax(0,1fr)); gap: .9rem; }
  .nearby-options { padding: 1rem; min-inline-size: 0; border: 1px solid var(--line); border-radius: .65rem; margin: 1.3rem 0 1rem; background: var(--paper); }
  .nearby-options legend { padding-inline: .4rem; font: 650 1.22rem/1.2 var(--display); }
  .nearby-grid, .explore-bottom { display: flex; flex-wrap: wrap; align-items: end; gap: .75rem 1rem; }
  .nearby-grid .field { flex: 1 1 8rem; max-inline-size: 13rem; }
  .explore-bottom .check { align-self: end; }
  .explore-bottom .field { flex: 1 1 10rem; max-inline-size: 14rem; }
  .distance-help { font-size: .87rem; margin-block-start: .65rem; }
  [data-location-status]:not(:empty) { margin-block-start: .5rem; font-weight: 700; }
  .result-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; column-gap: 1rem; margin-block: .83rem .6rem; }
  .pagination { justify-content: center; margin-block: 1rem;}
  .pagination button:disabled { opacity: .6; }
  @media (max-width: 58rem) { .explore-top { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 31rem) { .explore-top { grid-template-columns: 1fr; } .nearby-grid .field, .explore-bottom .field { max-inline-size: none; flex-basis: 100%; } }
</style>
<script>
  import {startExplorer} from '../scripts/explore';
  void startExplorer();
</script>
