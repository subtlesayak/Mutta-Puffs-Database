---
import {atlas} from '../lib/catalogue';
import {github, path, providerLabels} from '../lib/format';
import Icon from './Icon.astro';
import MetricFilters from './MetricFilters.astro';
import PlaceCard from './PlaceCard.astro';
import {labelSets, type Locale} from '../lib/locales';
import {finderCopy} from '../lib/finder-copy';
import {translatedPlaceName} from '../lib/place-search';
interface Props {locale?: Locale}
const {locale = 'en'} = Astro.props;
const t = labelSets[locale];
const copy = finderCopy[locale];

const areas = [...new Set(atlas.places.flatMap(p => [p.location.state, p.location.country]).filter((s): s is string => Boolean(s)))].sort();
const categories = [...new Set(atlas.places.map(p => p.category))].sort();
const cities = atlas.cities.filter(city => city.centre).sort((a,b) => a.name.localeCompare(b.name));
---
<section class="shell section" id="nearby" aria-labelledby="explore-title">
  <header class="heading">
    <p class="kicker">{t.directory}</p>
    <h2 id="explore-title">{t.find}</h2>
    <p class="muted">{t.help}</p>
  </header>
  <div data-explorer data-finder-copy={JSON.stringify(copy)} class="explorer">
    <form class="panel" data-filters aria-label={copy.filterPlaces}>
      <div class="explore-top">
        <label class="field">{t.search} <input type="search" name="search" placeholder={t.placeholder} /></label>
        <label class="field">{t.region} <select name="region"><option value="">{t.allRegions}</option>{areas.map(area => <option value={area}>{translatedPlaceName(area,locale)}</option>)}<option value="unassigned">{t.unknownCountry}</option></select></label>
        <label class="field">{t.district} <select name="district"><option value="">{t.allDistricts}</option></select></label>
        <label class="field">{t.verification} <select name="verification"><option value="">{t.anyStatus}</option>{Object.entries(copy.verification).map(([key,label]) => <option value={key}>{label}</option>)}</select></label>
      </div>
      <fieldset class="nearby-options" id="find-nearby">
        <legend>{t.nearby}</legend>
        <div class="nearby-grid">
          <button class="button" type="button" data-locate><Icon name="location" size={18} /> {t.useLocation}</button>
          <label class="field">{t.city} <select name="city"><option value="">{t.chooseCity}</option>
            {cities.map(city => <option value={city.id} data-centre={city.centre?.join(',')}>{translatedPlaceName(city.name,locale)}</option>)}
          </select></label>
          <label class="field">{t.distance} <select name="radius" disabled>
            <option value="5">5 km</option><option value="10">10 km</option><option value="25" selected>25 km</option>
            <option value="50">50 km</option><option value="100">100 km</option><option value="Infinity">{t.anyDistance}</option>
          </select></label>
          <button class="button secondary" type="button" data-clear-location hidden>{t.clearLocation}</button>
        </div>
        <p class="muted distance-help">{t.distanceHelp}</p>
        <p data-location-status role="status"></p>
      </fieldset>
      <div class="explore-bottom">
        <label class="field">{t.placeType} <select name="category"><option value="">{t.allTypes}</option>{categories.map(category => <option value={category}>{copy.categories[category] ?? category}</option>)}</select></label>
        <label class="field">{t.provider} <select name="provider">{Object.entries(providerLabels).map(([value,label]) => <option value={value}>{label}</option>)}</select></label>
        <label class="check"><input type="checkbox" name="notes" /> {t.notes}</label>
        <button type="reset" class="button secondary">{t.clear}</button>
      </div>
      <MetricFilters locale={locale} />
    </form>
    <noscript><p class="muted">{copy.noScript}</p><div class="actions"><a href={path('cities/')}>{copy.cityDirectory}</a><a href={github + '/blob/main/analysis/PLACES.md'}>{copy.fullList}</a></div></noscript>
    <div class="result-bar">
      <p class="muted" data-result-status role="status"></p>
      <a class="text-link" href={path('map/')} data-map-view><Icon name="map" size={18} /> {t.mapView}</a>
    </div>
    <ul class="place-grid" data-results>{atlas.places.slice(0,6).map(place => <PlaceCard place={place} locale={locale} />)}</ul>
    <div class="actions pagination" data-pagination hidden>
      <button type="button" class="button secondary" data-previous>{t.previous}</button>
      <span data-pages></span>
      <button type="button" class="button secondary" data-next>{t.next}</button>
    </div>
  </div>
</section>

<style>
  .explore-top { display: grid; grid-template-columns: minmax(0,1.4fr) repeat(3,minmax(0,1fr)); gap: .9rem; }
  .nearby-options { scroll-margin-block-start: 1rem; padding: 1rem; min-inline-size: 0; border: 1px solid var(--line); border-radius: .65rem; margin: 1.3rem 0 1rem; background: var(--paper); }
  .nearby-options legend { padding-inline: .4rem; font: 650 1.22rem/1.2 var(--display); }
  .nearby-grid, .explore-bottom { display: flex; flex-wrap: wrap; align-items: end; gap: .75rem 1rem; }
  .nearby-grid .field { flex: 1 1 8rem; max-inline-size: 13rem; }
  .explore-bottom .check { align-self: end; }
  .explore-bottom .field { flex: 1 1 10rem; max-inline-size: 14rem; }
  .distance-help { font-size: .87rem; margin-block-start: .65rem; }
  [data-location-status]:not(:empty) { margin-block-start: .5rem; font-weight: 700; }
  .result-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; column-gap: 1rem; margin-block: .83rem .6rem; }
  .pagination { justify-content: center; margin-block: 1rem;}
  .pagination button:disabled { opacity: .6; }
  @media (max-width: 58rem) { .explore-top { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 31rem) { .explore-top { grid-template-columns: 1fr; } .nearby-grid .field, .explore-bottom .field { max-inline-size: none; flex-basis: 100%; } }
</style>
<script>
  import {startExplorer} from '../scripts/explore';
  void startExplorer();
</script>
