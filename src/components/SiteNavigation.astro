---
import Icon from './Icon.astro';
import {path} from '../lib/format';

interface Props {
  variant: 'desktop' | 'mobile';
  pathname: string;
  activeSection?: string;
}

const { variant, pathname, activeSection } = Astro.props;
const links = [
  ['Explore', ''],
  ['Puff Map', 'map/'],
  ['Cities', 'cities/'],
  ['Puff Guide', 'guide/'],
  ['Insights', 'insights/'],
];
const contributeHref = path('contribute/');
---
<nav class={`navigation-${variant}`} aria-label="Main navigation">
  {links.map(([label, route]) => (
    <a href={path(route)} aria-current={pathname === path(route) ? 'page' : activeSection === label ? 'true' : undefined}>{label}</a>
  ))}
  <a class="button small" href={contributeHref} aria-current={pathname === contributeHref ? 'page' : undefined}>Contribute <Icon name="arrow" size={16} /></a>
</nav>
