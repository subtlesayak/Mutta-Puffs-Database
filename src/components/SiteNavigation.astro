---
import Icon from './Icon.astro';
import {localizedPath, path} from '../lib/format';
import {labelSets, type Locale} from '../lib/locales';

interface Props {
  variant: 'desktop' | 'mobile';
  pathname: string;
  activeSection?: string;
  locale: Locale;
  languageHref: string;
}

const {variant, pathname, activeSection, locale, languageHref} = Astro.props;
const labels = labelSets[locale];
const links = [
  ['Explore', localizedPath('',locale), labels.explore, locale],
  ['Puff Map', localizedPath('map/',locale), labels.map, locale],
  ['Cities', localizedPath('cities/',locale), labels.cities, locale],
  ['Puff Guide', localizedPath('guide/',locale), labels.guide, locale],
  ['Insights', path('insights/'), labels.insights, 'en'],
  ['Language', languageHref, labels.language, languageHref.startsWith('#') ? locale : 'en'],
];
const contributeHref = localizedPath('contribute/',locale);
---
<nav class={`navigation-${variant}`} aria-label={labels.mainNav}>
  {links.map(([section, destination, label, language]) => (
    <a href={destination} hreflang={language} aria-current={pathname === destination ? 'page' : activeSection === section ? 'true' : undefined}>{label}</a>
  ))}
  <a class="button small" href={contributeHref} hreflang={locale} aria-current={pathname === contributeHref ? 'page' : undefined}>{labels.contribute} <Icon name="arrow" size={16} /></a>
</nav>
