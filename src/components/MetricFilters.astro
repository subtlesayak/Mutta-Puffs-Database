---
import {atlas} from '../lib/catalogue';
import {formatMessage, localizedPath} from '../lib/format';
import {finderCopy} from '../lib/finder-copy';
import type {Locale} from '../lib/locales';
interface Props {collapsible?: boolean; locale?: Locale}
const {collapsible = true,locale = 'en'} = Astro.props;
const copy = finderCopy[locale];
const numbers = new Intl.NumberFormat(locale);
const Wrapper = collapsible ? 'details' : 'fieldset';
const metrics = Object.values(atlas.place_metrics);
const currencies = [...new Set(metrics.flatMap(metric => metric.price ? [metric.price.currency] : []))].sort();
const hasScores = metrics.some(metric => metric.score);
---
<Wrapper class="metric-filters">
  {collapsible ? <summary>{copy.metricTitle}</summary> : <legend>{copy.metricTitle}</legend>}
  {(currencies.length > 0 || hasScores) && <div class="fields">
    {currencies.length > 0 && <>
      <label class="field">{copy.priceStatus}
        <select name="price_status"><option value="">{copy.anyPrice}</option><option value="reported">{copy.hasPrice}</option></select>
      </label>
      <label class="field">{copy.currency} <select name="currency"><option value="">{copy.anyCurrency}</option>{currencies.map(currency => <option>{currency}</option>)}</select></label>
      <label class="field">{copy.maxPrice} <input name="max_price" type="number" inputmode="decimal" min="0" step="any" placeholder={copy.currencyHint} disabled /></label>
    </>}
    {hasScores && <label class="field">{copy.score} <select name="min_score"><option value="">{copy.anyScore}</option><option value="1">{copy.hasScore}</option>{[60,70,80,90].map(score => <option value={score}>{formatMessage(copy.scoreThreshold,{score:numbers.format(score)})}</option>)}</select></label>}
  </div>}
  {currencies.length > 0 && hasScores
    ? <p class="muted">{copy.metricsHelp}</p>
    : <p class="muted">
        {currencies.length === 0 && !hasScores ? copy.awaitingBoth : currencies.length === 0 ? copy.awaitingPrice : copy.awaitingReviews}
        {' '}<a href={localizedPath('contribute/?kind=' + (currencies.length === 0 ? 'observation' : 'review'),locale)}>{copy.report}</a>
      </p>}
</Wrapper>
