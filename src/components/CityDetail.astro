---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import PlaceCard from './PlaceCard.astro';
import {byId} from '../lib/catalogue';
import type {City} from '../lib/types';
import type {Locale} from '../lib/locales';
import {formatMessage, localizedPath} from '../lib/format';
import {directoryCopy, directoryCount} from '../lib/directory-copy';
import {missionCopy} from '../lib/mission-copy';
import {placeMissions} from '../lib/verification-missions';
import {translatedPlaceName} from '../lib/place-search';

interface Props {city: City; locale?: Locale}
const {city,locale = 'en'} = Astro.props;
const places = city.place_ids.map(id => byId.get(id)!).sort((a,b) => a.name.localeCompare(b.name));
const missions = new Set(places.flatMap(placeMissions));
const missionRoute = 'missions/?' + new URLSearchParams({area:city.name,mission:missions.has('pin') ? 'pin' : 'details'});
const copy = directoryCopy[locale];
const localName = (name: string) => translatedPlaceName(name,locale);
const location = [city.state,city.country].flatMap(name => name ? [localName(name)] : []).join(', ');
const fields = {city:localName(city.name),count:directoryCount(city.count,locale)};
const title = formatMessage(copy.cityHeading,fields);
---
<Base title={title} section="Cities" description={formatMessage(copy.cityDescription,fields)} locale={locale} languageRoute={'cities/' + city.id + '/'}>
  <div class="shell">
    <header class="page-head">
      <a class="text-link" href={localizedPath('cities/',locale)}>{copy.allCities}</a>
      <h1>{title}</h1>
      <p>{fields.count} · {location || copy.cityDirectory}</p>
      <div class="actions city-actions">
        <a class="button" href={localizedPath('map/?city=' + city.id,locale)}><Icon name="map" size={18} /> {copy.cityMap}</a>
        {city.centre && <a class="button secondary" href={localizedPath('?city=' + city.id + '#nearby',locale)}><Icon name="location" size={18} /> {formatMessage(copy.searchCity,fields)}</a>}
        {missions.size > 0 && <a class="text-link" href={localizedPath(missionRoute,locale)}>{missionCopy[locale].title}</a>}
      </div>
    </header>
    <ul class="place-grid">{places.map(place => <PlaceCard place={place} locale={locale} />)}</ul>
  </div>
</Base>
<style>.city-actions {margin-block-start: 1.15rem;}</style>
