---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import {localizedPath, path} from '../lib/format';
import {guideTranslations} from '../lib/guide-copy';
import {guideDestinations} from '../lib/navigation';
import {labelSets, type Locale} from '../lib/locales';

interface Props {locale?: Locale}
const {locale = 'en'} = Astro.props;
const title = labelSets[locale].guide;
const copy = locale === 'en' ? undefined : guideTranslations[locale];
const intro = copy?.intro ?? 'Plan a bakery outing, remember where you’ve been, and find out what goes into a good puff.';
---
<Base title={title} section="Puff Guide" description={intro} locale={locale} languageRoute="guide/">
  <div class="shell">
    <header class="page-head">
      <h1>{title}</h1>
      <p>{intro}</p>
    </header>
    <ul class="tile-grid guide-grid">
      {guideDestinations.map(destination => {
        const {route, localized} = destination;
        const {title:cardTitle, description, label} = copy?.cards[route] ?? destination;
        const language = localized ? locale : 'en';
        return (
          <li class:list={['panel', 'feature-tile', { 'guide-trails': route === 'trails/', 'guide-passport': route === 'passport/' }]}>
            {route === 'trails/' && (
              <img src={path('images/egg-puff.webp')} width="1536" height="1024" alt="" />
            )}
            <h2>{cardTitle}</h2>
            <p>{description}</p>
            <a class="text-link" href={localizedPath(route,language)} hreflang={language}>
              <span>{label}{copy && language !== locale && <small> ({copy.inEnglish})</small>}</span>
              <Icon name="arrow" size={16} />
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</Base>
<script>
  const grid = document.querySelector<HTMLElement>('.guide-grid');

  if (grid && 'ResizeObserver' in window) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.feature-tile'));

    const measureCards = () => {
      const gap = Number.parseFloat(getComputedStyle(grid).columnGap);
      // Reserve one grid row per pixel of card height, plus the space below it.
      const spans = cards.map(card => Math.ceil(card.getBoundingClientRect().height + gap));
      cards.forEach((card, index) => card.style.setProperty('--card-rows', String(spans[index])));
      grid.dataset.masonry = '';
    };

    measureCards();
    const observer = new ResizeObserver(measureCards);
    cards.forEach(card => observer.observe(card, { box: 'border-box' }));
  }
</script>
<style>
  .guide-grid {
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
  }
  .guide-grid .feature-tile { grid-template-rows: none; align-content: start; }
  .feature-tile h2, .feature-tile .text-link span { overflow-wrap: anywhere; }
  .feature-tile .text-link :global(svg) { flex-shrink: 0; }
  .feature-tile .text-link small { font-weight: 650; }
  .guide-trails { background: var(--butter); }
  .guide-passport { background: var(--sage); }
  .guide-trails img {
    inline-size: 100%;
    aspect-ratio: 2.25 / 1;
    object-fit: cover;
    border-radius: .6rem;
    margin-block-end: .25rem;
  }
  @media (min-width: 38rem) {
    .guide-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .guide-grid[data-masonry] { grid-auto-rows: 1px; row-gap: 0; }
    .guide-grid[data-masonry] .feature-tile { grid-row-end: span var(--card-rows); }
  }
  @media (min-width: 64rem) {
    .guide-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
