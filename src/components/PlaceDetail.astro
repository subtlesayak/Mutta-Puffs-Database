---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import {atlas} from '../lib/catalogue';
import {cityPath, formatDate, formatMessage, formatPrice, localizedPath, locality, path, providerLabels} from '../lib/format';
import {directoryCopy} from '../lib/directory-copy';
import {finderCopy} from '../lib/finder-copy';
import {translatedPlaceName} from '../lib/place-search';
import type {Locale} from '../lib/locales';
import type {Place, Provider, Review} from '../lib/types';

interface Props {place: Place; locale?: Locale}
const {place,locale = 'en'} = Astro.props;
const copy = directoryCopy[locale];
const finder = finderCopy[locale];
const localName = (name: string) => translatedPlaceName(name,locale);
const numbers = new Intl.NumberFormat(locale === 'en' ? 'en-IN' : locale);
const date = (value: string) => formatDate(value,locale === 'en' ? 'en-GB' : locale);
const area = locality(place.location,localName);
const city = atlas.cities.find(item => item.name === place.location.city);
const links = Object.entries(place.map_links) as [Provider, string][];
const observations = atlas.observations.filter(entry => entry.place_id === place.id).sort((a,b) => b.observed_on.localeCompare(a.observed_on));
const reviews = atlas.reviews.filter(entry => entry.place_id === place.id).sort((a,b) => b.visited_on.localeCompare(a.visited_on));
const score = atlas.place_metrics[place.id]?.score;
const show = {
  price: observations.find(item => item.price),
  portion: observations.find(item => item.egg_portion),
  batch: observations.find(item => item.fresh_batch_times?.length),
  availability: observations.find(item => item.availability),
};
const description = formatMessage(copy.placeDescription,{place:[place.name,area].filter(Boolean).join(' · ')});
const scoreKeys = Object.keys(copy.scoreLabels) as Array<keyof Review['scores']>;
const seo = {'@context':'https://schema.org','@type':'Place',name:place.name,description,
  ...(place.location.accuracy === 'verified' ? {geo:{'@type':'GeoCoordinates', latitude:place.location.latitude,longitude:place.location.longitude}} : {})};
---
<Base title={place.name} description={description} locale={locale} languageRoute={'places/' + place.id + '/'}>
  <script type="application/ld+json" set:html={JSON.stringify(seo).replace(/</g,'\\u003c')} />
  <div class="shell">
    <header class="page-head">
      <a class="text-link" href={city ? cityPath(city.id,locale) : localizedPath('#nearby',locale)}>{city ? formatMessage(copy.placesNear,{city:localName(city.name)}) : copy.explorePlaces}</a>
      <p class="kicker">{finder.categories[place.category] ?? place.category}</p>
      <h1>{place.name}</h1>
      <p>{area || finder.locationPending}</p>
      <div class="tags">
        <span class="tag">{finder.verification[place.verification.status]}</span>
        <span class:list={['tag',{estimate: place.location.accuracy === 'estimated'}]}>{finder.accuracy[place.location.accuracy]}</span>
      </div>
      <div class="actions place-actions">
        <button class="button secondary small" type="button" aria-pressed="false" data-bookmark={place.id}
          data-bookmark-saved={copy.saved} data-bookmark-removed={copy.removed} data-bookmark-error={copy.saveError} hidden>{copy.save}</button>
        <a class="text-link" href={path('passport/?place=' + place.id)} hreflang="en">{copy.visit}</a>
      </div>
      <p class="live-note" data-bookmark-status role="status"></p>
    </header>
    <div class="grid-2 details-grid">
      <section class="panel">
        <h2 class="panel-title">{copy.directions}</h2>
        {links.length ?
          <div class="actions">{links.map(([provider,link]) => <a class="button secondary" data-directions={provider} href={link} target="_blank" rel="noopener noreferrer">{providerLabels[provider]} <Icon name="external" size={16} /></a>)}</div>
          : <p class="muted">{finder.mapUnavailable}</p>}
        {place.location.latitude !== null && <a class="text-link" href={localizedPath('map/?place=' + place.id,locale)}>{copy.showPin} <Icon name="arrow" size={16} /></a>}
        {place.location.accuracy === 'estimated' && <p class="muted">{copy.estimated}</p>}
      </section>
      <section class="panel">
        <h2 class="panel-title">{copy.record}</h2>
        <dl class="record">
          <div><dt>{copy.price}</dt><dd>{show.price?.price ? formatPrice(show.price.price.amount,show.price.price.currency,numbers.resolvedOptions().locale) : copy.noReport}{show.price && <small>{date(show.price.observed_on)} · <a href={show.price.source}>{copy.source}</a></small>}</dd></div>
          <div><dt>{copy.eggPortion}</dt><dd>{show.portion?.egg_portion ? copy.portions[show.portion.egg_portion] : copy.unknown}{show.portion && <small>{date(show.portion.observed_on)} · <a href={show.portion.source}>{copy.source}</a></small>}</dd></div>
          <div><dt>{copy.batches}</dt><dd>{show.batch?.fresh_batch_times?.join(', ') ?? copy.noReport}{show.batch && <small>{copy.localTime} · {date(show.batch.observed_on)} · <a href={show.batch.source}>{copy.source}</a></small>}</dd></div>
          <div><dt>{copy.availability}</dt><dd>{show.availability?.availability ? copy.stock[show.availability.availability] : copy.noReport}{show.availability && <small>{date(show.availability.observed_on)} · <a href={show.availability.source}>{copy.source}</a></small>}</dd></div>
        </dl>
      </section>
      {place.note && <section class="panel"><h2 class="panel-title">{copy.archive}</h2><blockquote dir="auto">{place.note}</blockquote><p class="muted">{copy.archiveNote}</p></section>}
      <section class="panel">
        <h2 class="panel-title">{copy.reviews}</h2>
        {score && <p class="score"><strong>{numbers.format(score.score)}<small>/100</small></strong> {finder.score} · {formatMessage(score.count === 1 ? copy.approvedReview : copy.approvedReviews,{count:numbers.format(score.count)})} · <a href={path('leaderboard/')} hreflang="en">{copy.scoreMethod}</a></p>}
        {reviews.length ? <ol class="review-list">{reviews.map(review => <li>
          <p><strong>{date(review.visited_on)}</strong> <a href={review.source}>{copy.submission}</a></p>
          <p dir="auto">{review.note}</p>
          <p class="muted">{scoreKeys.map(key => copy.scoreLabels[key] + ' ' + numbers.format(review.scores[key]) + '/10').join(' · ')}</p>
        </li>)}</ol> : <p class="muted">{copy.noReviews}</p>}
        <a class="text-link" href={path('contribute/?kind=review&place=' + place.id)} hreflang="en">{copy.addReview} <Icon name="arrow" size={16} /></a>
      </section>
      <section class="panel"><h2 class="panel-title">{copy.photos}</h2>{place.photos.length ? <div class="grid-2">
        {place.photos.map(photo => <figure><img src={photo.url} alt={photo.alt} loading="lazy" referrerpolicy="no-referrer" /><figcaption><a href={photo.source}>{photo.credit}</a> · {photo.license}{photo.captured_on ? ' · ' + date(photo.captured_on) : ''}</figcaption></figure>)}
      </div> : <p class="muted">{copy.noPhotos}</p>}
        <a class="text-link" href={path('contribute/?kind=photo&place=' + place.id)} hreflang="en">{copy.addPhoto} <Icon name="arrow" size={16} /></a>
      </section>
      <section class="panel">
        <h2 class="panel-title">{copy.corrections}</h2>
        <p>{place.source.kind === 'original_maps_export' ? copy.sourceExport : copy.sourceCommunity}{place.source.source_row ? ' · ' + formatMessage(copy.row,{number:numbers.format(place.source.source_row)}) : ''}</p>
        {place.source.reference && <p><a href={place.source.reference}>{copy.original}</a></p>}
        {place.verification.last_verified && <p>{formatMessage(copy.verifiedOn,{date:date(place.verification.last_verified)})}{place.verification.reference && <> · <a href={place.verification.reference}>{copy.evidence}</a></>}</p>}
        <a class="text-link" href={path('contribute/?kind=correction&place=' + place.id)} hreflang="en">{copy.correct} <Icon name="arrow" size={16} /></a>
      </section>
    </div>
  </div>
</Base>
<style>
  .panel-title {font-size: 1.65rem; margin-block-end:.85rem;}
  .tags {display:flex; flex-wrap:wrap; gap:.5rem; margin-block-start:.65rem;}
  .record {display:grid; gap:.5rem; margin:0;}
  .record div {display:grid; grid-template-columns: minmax(6rem,1fr) minmax(0,1.2fr); gap:.65rem;}
  .record dt {font-weight: 750;}
  .record dd {margin:0;}
  .record small {display:block; color:var(--muted);}
  blockquote {margin:0 0 .8rem; padding-inline-start:.8rem; border-inline-start:3px solid var(--line);}
  figure {margin:0;}
  .review-list {padding-inline-start:1.5rem;}
  .place-actions {margin-block-start:.75rem;}
  .score strong {font:700 1.75rem var(--display);color:var(--pine);}
</style>
<script>
  import {enablePlaceBookmark} from '../scripts/passport';
  enablePlaceBookmark();
</script>
