{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subtlesayak.github.io/Mutta-Puffs-Database/schemas/v1/trail.json",
  "title": "MPDB trail v1",
  "type": "object", "additionalProperties": false,
  "required": ["id", "name", "description", "place_ids"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1, "maxLength": 800},
    "place_ids": {"type": "array", "uniqueItems": true, "minItems": 2, "items": {"type": "string", "pattern": "^mpdb-[a-z0-9]{8,24}$"}}
  }
}
