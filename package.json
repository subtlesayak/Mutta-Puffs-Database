{
  "name": "mutta-puffs-database",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "generate": "python3 scripts/build_atlas.py",
    "dev": "npm run generate && astro dev",
    "build": "npm run generate && astro build && node scripts/pack_pwa.mjs",
    "check": "npm run generate && astro check",
    "test": "python3 -m unittest discover -s tests && node --test tests/*.test.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@googlemaps/markerclusterer": "^2.6.2",
    "astro": "^6.0.0",
    "fuse.js": "^7.1.0",
    "maplibre-gl": "^5.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.67.0",
    "typescript": "~5.9.3"
  }
}
